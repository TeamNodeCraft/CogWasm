diff --git a/config.llvm.toml b/config.llvm.toml
new file mode 100644
index 00000000000..53f33fafc6a
--- /dev/null
+++ b/config.llvm.toml
@@ -0,0 +1,47 @@
+# Bootstrap config for a rustc whose host is wasm32-wasip1-threads, using LLVM
+# as the codegen backend. The wasi-sdk is extracted as ./wasi-sdk in the checkout.
+profile = "compiler"
+change-id = 9999999
+
+[rust]
+codegen-backends = ["llvm"]
+deny-warnings = false
+llvm-bitcode-linker = false
+# The wasm LLVM is built without tools (see the WASI CMake block), so there is
+# nothing for bootstrap to install into the compiler's bin directory.
+llvm-tools = false
+debug = false
+debuginfo-level = 0
+
+[llvm]
+static-libstdcpp = true
+ninja = false
+download-ci-llvm = false
+link-shared = false
+targets = "WebAssembly;X86"
+experimental-targets = ""
+
+[build]
+docs = false
+extended = false
+tools = []
+host = ["wasm32-wasip1-threads"]
+target = ["x86_64-unknown-linux-gnu", "wasm32-wasip1"]
+cargo-native-static = true
+
+[install]
+prefix = "dist"
+sysconfdir = "etc"
+
+[target.'wasm32-wasip1']
+wasi-root = "wasi-sdk/share/wasi-sysroot"
+linker = "wasi-sdk/bin/clang"
+codegen-backends = ["llvm"]
+
+[target.'wasm32-wasip1-threads']
+wasi-root = "wasi-sdk/share/wasi-sysroot"
+linker = "wasi-sdk/bin/clang"
+codegen-backends = ["llvm"]
+
+[target.'x86_64-unknown-linux-gnu']
+cc = "gcc"
