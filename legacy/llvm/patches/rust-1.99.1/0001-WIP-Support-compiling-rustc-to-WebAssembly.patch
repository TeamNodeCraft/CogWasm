     if !msvc_changed_path && let Some(path) = env::var_os("PATH") {
         new_path.extend(env::split_paths(&path));
     }
-    cmd.env("PATH", env::join_paths(new_path).unwrap());
+    // `env::join_paths` is not available on WASI (there is no `PATH` to search).
