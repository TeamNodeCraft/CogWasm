 pub static STACK_SIZE: OnceLock<usize> = OnceLock::new();
-pub const DEFAULT_STACK_SIZE: usize = 16 * 1024 * 1024;
+// WASI cannot grow or configure the main thread's stack, and rustc's recursive
+// frontend needs more than the native default when it cannot spawn a thread.
+pub const DEFAULT_STACK_SIZE: usize = if cfg!(target_family = "wasm") {
+    32 * 1024 * 1024
+} else {
+    16 * 1024 * 1024
+};
 
 fn init_stack_size(early_dcx: &EarlyDiagCtxt) -> usize {
     // Obey the environment setting or default
@@ -164,6 +170,18 @@ fn run_in_thread_with_globals<F: FnOnce(CurrentGcx) -> R + Send, R: Send>(
     // the parallel compiler, in particular to ensure there is no accidental
     // sharing of data between the main thread and the compilation thread
     // (which might cause problems for the parallel compiler).
+    //
+    // WASI (preview1) cannot spawn threads, so run on the main thread there.
+    // The stack size is fixed by the linker for the main thread instead.
+    if cfg!(target_family = "wasm") {
+        return rustc_span::create_session_globals_then(
+            edition,
+            extra_symbols,
+            Some(sm_inputs),
+            || f(CurrentGcx::new()),
+        );
+    }
+
     let builder = thread::Builder::new().name("rustc".to_string()).stack_size(thread_stack_size);
 
     // We build the session globals and run `f` on the spawned thread, because
