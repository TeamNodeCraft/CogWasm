**/target/*

# Old logo experiments stay local; only the published logo in artwork/cog-logo/ is tracked.
artwork/*
!artwork/cog-logo/

# Benchmark scratch space and local result files; committed points live in
# bench/history/.
bench/work/
bench/results/
# Generated by bench/chart/chart.py and published to the bench-history
# release; only the generator, page and fixtures are committed.
bench/chart/chart.svg
bench/chart/data.json
__pycache__/
*.pyc

# Assembled GitHub Pages output (site + chart page + release mirrors).
# deploy_pages.yml builds it in CI; local builds should use a temp directory or
# this ignored one.
/public/

# The ignored toolchain root: downloads, upstream checkouts and build outputs.
/toolchain/

# Build artifacts; keep tracked results/*.md and results/*.json.
*.wasm
*.o
*.cwasm
*.cwasm.json

# Local/CI compiler build log (the workflow publishes its own full log).
/docs/results/build-rustc-wasm.log

# Release bundle outputs (local dry runs and the packaging script).
/release/out/
/release/dist/
