From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stage C <stage-c@example.invalid>
Date: Thu, 19 Nov 2026 15:40:00 +1030
Subject: [PATCH] wasm: inline tiny leaf functions before codegen

cg_clif compiles a codegen unit's functions only after collecting all of them,
but it never inlines. rustc's MIR inliner runs before monomorphization, so the
one- and two-instruction operator and cast helpers that a generic function
instantiates (the ones libm's maths is built from) remain calls in CLIF. On
wasm each one becomes a real `call` in the hot loop, while LLVM removes them in
its already-monomorphized IR.

Before compiling the unit, collect every function body that
`clif_to_wasm::is_small_leaf` accepts and run
`clif_to_wasm::inline_small_leaf_functions` over the whole unit, so a call is
inlined regardless of which function in the unit is compiled first. Only the
wasm object path is changed; the native path is untouched.

The helper functions are added to `CodegenedFunction` next to the body they
operate on, which keeps the CLIF private to base.rs. Correctness rests on the
clif-to-wasm policy: inlining never moves a memory access, call, trap or branch
into or out of a callee.
---

diff --git a/src/base.rs b/src/base.rs
--- a/src/base.rs
+++ b/src/base.rs
@@ -30,6 +30,24 @@
     clif_comments: CommentWriter,
     func_debug_cx: Option<FunctionDebugContext>,
     inline_asm: String,
+}
+
+impl CodegenedFunction {
+    /// The body to offer for inlining elsewhere, if it is small enough.
+    pub(crate) fn inlinable_body(&self) -> Option<&Function> {
+        if clif_to_wasm::is_small_leaf(&self.func) {
+            Some(&self.func)
+        } else {
+            None
+        }
+    }
+
+    /// Inline this function's direct calls to the tiny leaf functions in
+    /// `callees`.
+    pub(crate) fn inline_small_calls(&mut self, callees: &[Function]) -> Result<bool, String> {
+        clif_to_wasm::inline_small_leaf_functions(&mut self.func, callees)
+            .map_err(|e| format!("{}: {e}", self.symbol_name))
+    }
 }
 
 pub(crate) fn codegen_fn<'tcx>(
diff --git a/src/driver/aot.rs b/src/driver/aot.rs
--- a/src/driver/aot.rs
+++ b/src/driver/aot.rs
@@ -342,6 +342,30 @@
     cgu_name: String,
     kind: ModuleKind,
 ) -> Result<CompiledModule, String> {
+    // Inline calls to tiny leaf functions before compiling anything. cg_clif
+    // has no inliner of its own, and rustc's MIR inliner runs before
+    // monomorphization, so the one- and two-instruction `core` operator
+    // helpers that a generic function instantiates stay calls in CLIF. On
+    // wasm each of those is a real `call` in a hot loop. Every function in
+    // this codegen unit is available here, including the ones compiled
+    // later in the unit, so a call in either direction can be inlined.
+    //
+    // Only wasm is affected for now: the native path has its own object
+    // writer and this pass has not been measured there.
+    if matches!(&aot_module.module, AotObject::Wasm(_)) {
+        let mut callees = Vec::new();
+        for codegened_func in &aot_module.codegened_functions {
+            if let Some(body) = codegened_func.inlinable_body() {
+                callees.push(body.clone());
+            }
+        }
+        if !callees.is_empty() {
+            for codegened_func in &mut aot_module.codegened_functions {
+                codegened_func.inline_small_calls(&callees)?;
+            }
+        }
+    }
+
     prof.generic_activity_with_arg("compile functions", &*cgu_name).run(|| {
         cranelift_codegen::timing::set_thread_profiler(Box::new(super::MeasuremeProfiler(
             prof.clone(),
