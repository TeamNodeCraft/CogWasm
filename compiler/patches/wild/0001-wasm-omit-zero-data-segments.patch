diff --git a/wild/tests/sources/wasm/zero-data/zero-data.c b/wild/tests/sources/wasm/zero-data/zero-data.c
new file mode 100644
index 00000000..0c1941df
--- /dev/null
+++ b/wild/tests/sources/wasm/zero-data/zero-data.c
@@ -0,0 +1,22 @@
+//#Config:default
+//#MaxFileSize:4096
+//#ExpectDataSegmentCount:1
+//#ExpectNoZeroDataSegments:true
+
+// A zero-initialised buffer becomes an all-zero active data segment in the
+// object. Linear memory already starts zeroed, so the linker must not encode
+// those 16 KiB. The volatile reads keep the buffer observable so the test also
+// checks that its address is still backed by the initial memory.
+volatile char zero_buf[16384];
+volatile char tail_buf[4] = {1, 2, 3, 4};
+
+void _start(void) {
+  for (unsigned i = 0; i < sizeof(zero_buf); ++i) {
+    if (zero_buf[i] != 0) {
+      __builtin_trap();
+    }
+  }
+  if (tail_buf[0] != 1 || tail_buf[3] != 4) {
+    __builtin_trap();
+  }
+}
