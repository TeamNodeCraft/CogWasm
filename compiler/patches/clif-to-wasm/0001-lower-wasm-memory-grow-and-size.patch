+/// The wasm intrinsic selected by a direct call to a reserved test-case name.
+fn wasm_intrinsic(dfg: &DataFlowGraph, func_ref: FuncRef) -> Option<WasmIntrinsic> {
+    let ExternalName::TestCase(name) = &dfg.ext_funcs[func_ref].name else {
+        return None;
+    };
+    WasmIntrinsic::from_symbol_name(core::str::from_utf8(name.raw()).ok()?)
+}
+
+impl Emitter<'_> {
+    /// Lower a call to a [`WasmIntrinsic`] to the corresponding instruction.
+    fn wasm_intrinsic(
+        &mut self,
+        intrinsic: WasmIntrinsic,
+        sig: &Signature,
+        nargs: usize,
+    ) -> Result<()> {
+        if self.config.module.address_type != crate::AddressType::I32 {
+            return error::unsupported(format!("{} with a 64-bit memory", intrinsic.symbol_name()));
+        }
+        let (params, results) = intrinsic.signature();
+        let matches_signature = sig.params.len() == params.len()
+            && sig
+                .params
+                .iter()
+                .zip(params)
+                .all(|(p, &t)| p.value_type == t)
+            && sig.returns.len() == results.len()
+            && sig
+                .returns
+                .iter()
+                .zip(results)
+                .all(|(r, &t)| r.value_type == t);
+        if !matches_signature || nargs != params.len() {
+            return error::unsupported(format!(
+                "call to {} with the wrong signature",
+                intrinsic.symbol_name()
+            ));
+        }
+        match intrinsic {
+            WasmIntrinsic::MemoryGrow => {
+                self.operand()?;
+                self.ins(I::MemoryGrow(self.config.module.memory_index.0));
+            }
+            WasmIntrinsic::MemorySize => {
+                self.ins(I::MemorySize(self.config.module.memory_index.0));
+            }
+        }
+        Ok(())
+    }
+}
diff --git a/src/wasm_intrinsic.rs b/src/wasm_intrinsic.rs
new file mode 100644
index 0000000..93fbe80
--- /dev/null
+++ b/src/wasm_intrinsic.rs
@@ -0,0 +1,68 @@
+//! WebAssembly instructions that have no Cranelift opcode.
+//!
+//! Cranelift's IR is ISA-neutral and has no `memory.grow` or `memory.size`.
+//! A frontend that needs them calls a function with one of the reserved
+//! [`ExternalName::TestCase`](cranelift_codegen::ir::ExternalName::TestCase)
+//! names below; [`compile_function`](crate::compile_function) replaces the call
+//! with the instruction. These are reserved names, so no environment entry or
+//! module symbol is needed; a frontend only has to call a function with the
+//! right name and signature.
+//!
+//! ```text
+//! function %size() -> i32 {
+//!     fn0 = %__clif_to_wasm_memory_size() -> i32
+//! block0:
+//!     v0 = call fn0()
+//!     return v0
+//! }
+//! ```
+//!
+//! The calls must have the exact signature shown for the instruction
+//! (`(i32) -> i32` for grow, `() -> i32` for size) and must not be tail
+//! calls. They apply to
+//! [`ModuleLayout::memory_index`](crate::ModuleLayout::memory_index) and only
+//! to a 32-bit memory.
+
+use cranelift_codegen::ir::{Type, types};
+
+/// A wasm instruction selected by a reserved call target instead of a
+/// Cranelift instruction.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash)]
+#[non_exhaustive]
+pub enum WasmIntrinsic {
+    /// `memory.grow`, from a call to `__clif_to_wasm_memory_grow`:
+    /// `(i32) -> i32`, returning the previous size in pages or -1 on failure.
+    MemoryGrow,
+    /// `memory.size`, from a call to `__clif_to_wasm_memory_size`:
+    /// `() -> i32`, the current size in pages.
+    MemorySize,
+}
+
+impl WasmIntrinsic {
+    /// All intrinsics, for lookups.
+    const ALL: [WasmIntrinsic; 2] = [WasmIntrinsic::MemoryGrow, WasmIntrinsic::MemorySize];
+
+    /// The reserved symbol name that selects this instruction.
+    pub const fn symbol_name(self) -> &'static str {
+        match self {
+            WasmIntrinsic::MemoryGrow => "__clif_to_wasm_memory_grow",
+            WasmIntrinsic::MemorySize => "__clif_to_wasm_memory_size",
+        }
+    }
+
+    /// The intrinsic selected by `name`, if any.
+    pub fn from_symbol_name(name: &str) -> Option<Self> {
+        Self::ALL
+            .into_iter()
+            .find(|intrinsic| intrinsic.symbol_name() == name)
+    }
+
+    /// The call signature this intrinsic requires.
+    pub(crate) fn signature(self) -> (&'static [Type], &'static [Type]) {
+        const I32: &[Type] = &[types::I32];
+        match self {
+            WasmIntrinsic::MemoryGrow => (I32, I32),
+            WasmIntrinsic::MemorySize => (&[], I32),
+        }
+    }
+}
diff --git a/tests/memory.rs b/tests/memory.rs
new file mode 100644
index 0000000..714eae1
--- /dev/null
+++ b/tests/memory.rs
@@ -0,0 +1,143 @@
+//! `memory.size` / `memory.grow` lowering, selected by calls to the reserved
+//! reserved symbols. The CLIF parser must accept these test-case names,
+//! and the emitted wasm must contain the corresponding instructions (not
+//! calls) and grow a real memory.
+
+mod harness;
+
+use clif_to_wasm::Config;
+use wasmparser::{Operator, Parser, Payload};
+use wasmtime::{Engine, Instance, Module, Store};
+
+const CLIF: &str = "
+function %size() -> i32 {
+    fn0 = %__clif_to_wasm_memory_size() -> i32
+block0:
+    v0 = call fn0()
+    return v0
+}
+
+function %grow(i32) -> i32 {
+    fn0 = %__clif_to_wasm_memory_grow(i32) -> i32
+block0(v0: i32):
+    v1 = call fn0(v0)
+    return v1
+}
+
+function %size_after_grow(i32) -> i32 {
+    fn0 = %__clif_to_wasm_memory_size() -> i32
+    fn1 = %__clif_to_wasm_memory_grow(i32) -> i32
+block0(v0: i32):
+    v1 = call fn1(v0)
+    v2 = call fn0()
+    return v2
+}
+";
+
+fn count_intrinsics(wasm: &[u8]) -> (usize, usize) {
+    let mut size = 0;
+    let mut grow = 0;
+    for payload in Parser::new(0).parse_all(wasm) {
+        if let Payload::CodeSectionEntry(body) = payload.unwrap() {
+            for op in body.get_operators_reader().unwrap() {
+                match op.unwrap() {
+                    Operator::MemorySize { mem } => {
+                        assert_eq!(mem, 0);
+                        size += 1;
+                    }
+                    Operator::MemoryGrow { mem } => {
+                        assert_eq!(mem, 0);
+                        grow += 1;
+                    }
+                    _ => {}
+                }
+            }
+        }
+    }
+    (size, grow)
+}
+
+#[test]
+fn memory_size_and_grow_instructions() {
+    let funcs = cranelift_reader::parse_functions(CLIF).unwrap();
+    let (wasm, unsupported) = harness::compile_module(&funcs, &Config::default());
+    assert!(unsupported.is_empty(), "{unsupported:?}");
+    harness::validate(&wasm).unwrap();
+
+    let (size, grow) = count_intrinsics(&wasm);
+    assert_eq!((size, grow), (2, 2), "emitted instructions");
+
+    let engine = Engine::default();
+    let module = Module::new(&engine, &wasm).unwrap();
+    let mut store = Store::new(&engine, ());
+    let instance = Instance::new(&mut store, &module, &[]).unwrap();
+    let size_fn = instance
+        .get_typed_func::<(), i32>(&mut store, "size")
+        .unwrap();
+    let grow_fn = instance
+        .get_typed_func::<i32, i32>(&mut store, "grow")
+        .unwrap();
+    let after_fn = instance
+        .get_typed_func::<i32, i32>(&mut store, "size_after_grow")
+        .unwrap();
+
+    assert_eq!(
+        size_fn.call(&mut store, ()).unwrap(),
+        harness::MEMORY_PAGES as i32
+    );
+    // The first growth returns the size before growing.
+    assert_eq!(
+        grow_fn.call(&mut store, 2).unwrap(),
+        harness::MEMORY_PAGES as i32
+    );
+    assert_eq!(
+        size_fn.call(&mut store, ()).unwrap(),
+        harness::MEMORY_PAGES as i32 + 2
+    );
+    // Growing inside the callee reports the already-grown size.
+    assert_eq!(
+        after_fn.call(&mut store, 1).unwrap(),
+        harness::MEMORY_PAGES as i32 + 3
+    );
+
+    // The new pages are real memory.
+    let memory = instance.get_memory(&mut store, "memory").unwrap();
+    let new_page = (harness::MEMORY_PAGES + 3) as usize * 65536;
+    memory.write(&mut store, new_page - 8, b"growable").unwrap();
+    let mut back = [0u8; 8];
+    memory.read(&store, new_page - 8, &mut back).unwrap();
+    assert_eq!(&back, b"growable");
+}
+
+#[test]
+fn wrong_signature_is_rejected() {
+    let clif = "
+function %grow_i64(i64) -> i32 {
+    fn0 = %__clif_to_wasm_memory_grow(i64) -> i32
+block0(v0: i64):
+    v1 = call fn0(v0)
+    return v1
+}
+";
+    let funcs = cranelift_reader::parse_functions(clif).unwrap();
+    let (wasm, unsupported) = harness::compile_module(&funcs, &Config::default());
+    assert_eq!(unsupported.len(), 1, "{unsupported:?}");
+    assert!(
+        unsupported[0].contains("wrong signature"),
+        "{unsupported:?}"
+    );
+    // The harness substitutes a valid stub, so the module still validates.
+    harness::validate(&wasm).unwrap();
+}
+
+#[test]
+fn memory64_is_rejected() {
+    let funcs = cranelift_reader::parse_functions(CLIF).unwrap();
+    let config = harness::config(|c| c.module.address_type = clif_to_wasm::AddressType::I64);
+    let (wasm, unsupported) = harness::compile_module(&funcs, &config);
+    assert_eq!(unsupported.len(), 3, "{unsupported:?}");
+    for problem in &unsupported {
+        assert!(problem.contains("64-bit memory"), "{problem}");
+    }
+    harness::validate(&wasm).unwrap();
+}
