diff --git a/tests/inline.rs b/tests/inline.rs
new file mode 100644
--- /dev/null
+++ b/tests/inline.rs
@@ -0,0 +1,160 @@
+//! Inlining of tiny leaf functions: the call disappears, the result does not
+//! change, and anything with an effect or a larger body is left alone.
+
+mod harness;
+
+use clif_to_wasm::{Config, inline_small_leaf_functions, is_small_leaf};
+use cranelift_codegen::data_value::DataValue;
+use cranelift_codegen::ir::{Function, Opcode, types};
+
+const CLIF: &str = "
+function u0:0(i64) -> i64 {
+block0(v0: i64):
+    v1 = iconst.i64 3
+    v2 = ishl v0, v1
+    return v2
+}
+
+function u0:1(i64, i64) -> i64 {
+    fn0 = u0:0(i64) -> i64
+block0(v0: i64, v1: i64):
+    v2 = call fn0(v0)
+    v3 = iadd v2, v1
+    return v3
+}
+
+function u0:2(i64) -> i64 {
+block0(v0: i64):
+    v1 = load.i64 v0
+    return v1
+}
+
+function u0:3(i64) -> i64 {
+block0(v0: i64):
+    v1 = iconst.i64 1
+    v2 = iadd v0, v1
+    v3 = iadd v2, v1
+    v4 = iadd v3, v1
+    v5 = iadd v4, v1
+    v6 = iadd v5, v1
+    v7 = iadd v6, v1
+    v8 = iadd v7, v1
+    v9 = iadd v8, v1
+    v10 = iadd v9, v1
+    v11 = iadd v10, v1
+    v12 = iadd v11, v1
+    v13 = iadd v12, v1
+    v14 = iadd v13, v1
+    v15 = iadd v14, v1
+    v16 = iadd v15, v1
+    v17 = iadd v16, v1
+    return v17
+}
+
+function u0:4(i64) -> i64 {
+    fn0 = u0:3(i64) -> i64
+block0(v0: i64):
+    v1 = call fn0(v0)
+    return v1
+}
+
+function u0:5(i64) -> i64 {
+block0(v0: i64):
+    jump block1(v0)
+block1(v1: i64):
+    v2 = iconst.i64 1
+    v3 = iadd v1, v2
+    return v3
+}
+
+function u0:6(i64) -> i64 {
+    fn0 = u0:5(i64) -> i64
+block0(v0: i64):
+    v1 = call fn0(v0)
+    return v1
+}
+";
+
+fn functions() -> Vec<Function> {
+    cranelift_reader::parse_functions(CLIF).unwrap()
+}
+
+/// Inline calls in `caller` using `body` as the only candidate.
+fn inline_small(caller: &mut Function, body: &Function) -> bool {
+    inline_small_leaf_functions(caller, std::slice::from_ref(body)).unwrap()
+}
+
+fn calls(func: &Function) -> usize {
+    func.layout
+        .blocks()
+        .flat_map(|block| func.layout.block_insts(block))
+        .filter(|inst| func.dfg.insts[*inst].opcode() == Opcode::Call)
+        .count()
+}
+
+#[test]
+fn small_leaf_is_inlined() {
+    let funcs = functions();
+    let small = &funcs[0];
+    assert!(is_small_leaf(small));
+    let mut caller = funcs[1].clone();
+    assert_eq!(calls(&caller), 1);
+
+    assert!(inline_small(&mut caller, small));
+    assert_eq!(calls(&caller), 0, "the call was replaced by its body");
+}
+
+#[test]
+fn inlined_call_has_the_same_result() {
+    let mut funcs = functions();
+    let small = funcs[0].clone();
+    assert!(inline_small(&mut funcs[1], &small));
+
+    let (wasm, unsupported) = harness::compile_module(&funcs, &Config::default());
+    assert!(unsupported.is_empty(), "{unsupported:?}");
+    harness::validate(&wasm).unwrap();
+
+    let runner = harness::Runner::new(&wasm).unwrap();
+    let result = runner
+        .call(
+            "u0:1",
+            &[DataValue::I64(7), DataValue::I64(1)],
+            &[types::I64],
+        )
+        .unwrap()
+        .expect("the inlined caller returns");
+    assert_eq!(result, vec![DataValue::I64(57)]);
+}
+
+#[test]
+fn functions_with_effects_are_not_candidates() {
+    let funcs = functions();
+    // A load is a memory operation, so the body cannot be duplicated.
+    assert!(!is_small_leaf(&funcs[2]));
+
+    let mut caller = funcs[1].clone();
+    let inlined = inline_small_leaf_functions(&mut caller, &[]).unwrap();
+    assert!(!inlined);
+    assert_eq!(calls(&caller), 1);
+}
+
+#[test]
+fn a_body_that_is_too_large_is_kept_out() {
+    let funcs = functions();
+    // Sixteen additions plus the constant and the return exceed the limit.
+    assert!(!is_small_leaf(&funcs[3]));
+    let mut caller = funcs[4].clone();
+    assert!(!inline_small(&mut caller, &funcs[3]));
+    assert_eq!(calls(&caller), 1);
+}
+
+#[test]
+fn a_linear_multi_block_body_is_inlined() {
+    let funcs = functions();
+    // cg_clif gives every function an entry block that jumps to its body, so a
+    // one-expression wrapper already has two blocks.
+    assert!(is_small_leaf(&funcs[5]));
+    let mut caller = funcs[6].clone();
+    assert!(inline_small(&mut caller, &funcs[5]));
+    assert_eq!(calls(&caller), 0);
+}
