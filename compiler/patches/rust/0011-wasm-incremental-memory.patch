-                self.res = self.file.write_all(buf);
+                self.res = match &mut self.output {
+                    Output::File(file) => file.write_all(buf),
+                    Output::Memory(bytes) => {
+                        bytes.extend_from_slice(buf);
+                        Ok(())
+                    }
+                };
                 if let Some(f) = &mut self.flush_strategy {
                     f(buf);
                 }
@@ -212,10 +250,17 @@ pub fn finish(&mut self) -> FileEncodeResult {
         {
             self.finished = true;
         }
-        match std::mem::replace(&mut self.res, Ok(())) {
+        let result = match std::mem::replace(&mut self.res, Ok(())) {
             Ok(()) => Ok(self.position()),
             Err(e) => Err((self.path.clone(), e)),
+        };
+        if result.is_ok()
+            && let Output::Memory(bytes) = &mut self.output
+        {
