+    pub fn new_memory<P: AsRef<Path>>(path: P) -> Self {
+        FileEncoder {
+            buf: vec![0u8; BUF_SIZE].into_boxed_slice().try_into().unwrap(),
+            path: path.as_ref().into(),
+            buffered: 0,
+            flushed: 0,
+            output: Output::Memory(Vec::new()),
