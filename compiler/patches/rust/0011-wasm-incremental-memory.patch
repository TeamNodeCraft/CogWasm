@@ -0,0 +1,101 @@
+//! Process-local storage for incremental artifacts encoded into memory.
+//!
+//! A serving rustc can keep its incremental state alive between compile
+//! requests instead of writing it to disk and reading it back. Only encoders
+//! created with `FileEncoder::new_memory` publish here, and only the
+//! incremental machinery asks for them; the default file-backed path does not
+//! touch this map.
+
+use std::collections::BTreeMap;
+use std::path::{Path, PathBuf};
+use std::sync::{Mutex, MutexGuard};
+
+/// rustc renames a session directory at the end of a compile, and names the
+/// next session differently. The artifacts therefore live under a stable
+/// key: the incremental crate directory plus the file name, without the
+/// per-session directory between them.
+fn key(path: &Path) -> PathBuf {
+    let Some(file_name) = path.file_name() else {
+        return path.to_owned();
+    };
+    let Some(crate_dir) = path.parent().and_then(Path::parent) else {
+        return path.to_owned();
+    };
+    crate_dir.join(file_name)
+}
+
+/// Bytes published by a finished in-memory encoder, keyed by their path.
+static FILES: Mutex<BTreeMap<PathBuf, Vec<u8>>> = Mutex::new(BTreeMap::new());
+
+/// Renames requested before the encoder that writes `from` has finished.
+///
+/// The dep graph is renamed from its staging path in `save_dep_graph`, but the
+/// encoder only finishes (and publishes) afterwards. Record the destination
+/// so the publish lands at the final path.
+static PENDING_RENAMES: Mutex<BTreeMap<PathBuf, PathBuf>> = Mutex::new(BTreeMap::new());
+
+fn pending_renames() -> MutexGuard<'static, BTreeMap<PathBuf, PathBuf>> {
+    PENDING_RENAMES.lock().unwrap_or_else(std::sync::PoisonError::into_inner)
+}
+
+fn files() -> MutexGuard<'static, BTreeMap<PathBuf, Vec<u8>>> {
+    // The map only holds finished encoded artifacts. A panic elsewhere must
+    // not disable the cache for the rest of the serving session.
+    FILES.lock().unwrap_or_else(std::sync::PoisonError::into_inner)
+}
+
+/// Publish `bytes` under `path`, replacing any previous value.
+pub fn insert(path: PathBuf, bytes: Vec<u8>) {
+    let key = key(&path);
+    let mut files = files();
+    let destination = pending_renames().remove(&key).unwrap_or(key);
+    files.insert(destination, bytes);
+}
+
+/// Remove and return the bytes stored under `path`.
+pub fn take(path: &Path) -> Option<Vec<u8>> {
+    files().remove(&key(path))
+}
+
+/// Move the bytes stored under `from` to `to`.
+pub fn rename(from: &Path, to: &Path) {
+    let from = key(from);
+    let to = key(to);
+    let mut files = files();
+    if let Some(bytes) = files.remove(&from) {
+        files.insert(to, bytes);
+    } else {
+        pending_renames().insert(from, to);
+    }
+}
+
+/// Remove the bytes stored under `path`, if any.
+pub fn remove(path: &Path) {
+    let key = key(path);
+    files().remove(&key);
+    pending_renames().remove(&key);
+}
+
+#[cfg(test)]
+mod tests {
+    use std::path::PathBuf;
+
+    use super::{insert, rename, take};
+
+    fn path(file: &str, session: &str) -> PathBuf {
+        PathBuf::from("/incremental/cratehash").join(session).join(file)
+    }
+
+    #[test]
+    fn a_new_session_directory_finds_the_previous_artifact() {
+        insert(path("query-cache.bin", "s-old"), vec![1, 2]);
+        assert_eq!(take(&path("query-cache.bin", "s-new")), Some(vec![1, 2]));
+    }
+
+    #[test]
+    fn a_rename_before_the_encoder_finishes_lands_at_the_destination() {
+        rename(&path("dep-graph.part.bin", "s-new"), &path("dep-graph.bin", "s-new"));
+        insert(path("dep-graph.part.bin", "s-new"), vec![3]);
+        assert_eq!(take(&path("dep-graph.bin", "s-next")), Some(vec![3]));
+    }
+}
