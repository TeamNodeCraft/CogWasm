From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Stage C <stage-c@example.invalid>
Date: Thu, 19 Nov 2026 04:58:54 +0000
Subject: [PATCH] generate-copyright: read notices from out-of-tree path deps

`x.py install` vendors crates.io dependencies under VENDOR_DIR, but the
patched clif-to-wasm is a path dependency outside the rust tree. It is never
vendored, so load_important_files() tried to read
VENDOR_DIR/clif-to-wasm-0.3.0 and failed with ENOENT in the final
generate-copyright packaging step.

Record each package's source directory while reading cargo metadata, and use
it for notices when the vendor copy is absent. The vendor directory stays the
first choice, so normal crates.io dependencies are unaffected.

The test builds a package directory with a Cargo.toml and LICENSE files and no
vendor copy; without the fallback it fails with the ENOENT this patch removes.

This patch was changed by the contributors to this repository.
---
 src/tools/generate-copyright/src/cargo_metadata.rs | 152 +++++++++++++++++++-
 1 file changed, 151 insertions(+), 1 deletion(-)

diff --git a/src/tools/generate-copyright/src/cargo_metadata.rs b/src/tools/generate-copyright/src/cargo_metadata.rs
--- a/src/tools/generate-copyright/src/cargo_metadata.rs
+++ b/src/tools/generate-copyright/src/cargo_metadata.rs
@@ -37,6 +37,12 @@
     pub notices: BTreeMap<String, String>,
     /// If this is true, this dep is in the Rust Standard Library
     pub is_in_libstd: Option<bool>,
+    /// The directory containing the package's manifest.
+    ///
+    /// Bootstrap vendors normal crates.io dependencies, but a path dependency
+    /// lives outside the Rust tree and is never vendored. Notices for such a
+    /// package must be read from its own source directory.
+    pub(crate) source_dir: Option<PathBuf>,
 }
 
 /// Use `cargo metadata` to get a list of dependencies and their license data. License files will
@@ -92,6 +98,9 @@
                 continue;
             }
             // otherwise it's an out-of-tree dependency
+            let source_dir = package_manifest_path
+                .parent()
+                .map(|parent| parent.as_std_path().to_path_buf());
             let package_id =
                 Package { name: package.name.to_string(), version: package.version.to_string() };
             output.insert(
@@ -101,6 +110,7 @@
                     authors: package.authors,
                     notices: BTreeMap::new(),
                     is_in_libstd: None,
+                    source_dir,
                 },
             );
         }
@@ -121,7 +131,21 @@
     let name_version = format!("{}-{}", package.name, package.version);
     println!("Scraping notices for {}...", name_version);
     let dep_vendor_path = vendor_root.join(name_version);
-    for entry in std::fs::read_dir(dep_vendor_path)? {
+    // Bootstrap vendors normal crates.io dependencies, so prefer the vendor
+    // copy. A path dependency (for example clif-to-wasm) is out-of-tree and is
+    // not vendored; its licence and notice files are next to its manifest.
+    let scan_path = if dep_vendor_path.is_dir() {
+        dep_vendor_path
+    } else if let Some(source_dir) = &dep.source_dir {
+        if source_dir.is_dir() {
+            source_dir.clone()
+        } else {
+            return Err(Error::Scraping(source_dir.clone()));
+        }
+    } else {
+        return Err(Error::Scraping(dep_vendor_path));
+    };
+    for entry in std::fs::read_dir(&scan_path)? {
         let entry = entry?;
         let metadata = entry.metadata()?;
         let path = entry.path();
@@ -162,3 +186,129 @@
     }
     Ok(())
 }
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use std::sync::atomic::{AtomicU64, Ordering};
+
+    static COUNTER: AtomicU64 = AtomicU64::new(0);
+
+    struct TempDir(PathBuf);
+
+    impl TempDir {
+        fn new() -> Self {
+            let unique = COUNTER.fetch_add(1, Ordering::Relaxed);
+            let path = std::env::temp_dir().join(format!(
+                "generate-copyright-notices-{}-{unique}",
+                std::process::id()
+            ));
+            std::fs::create_dir_all(&path).expect("creating the test temp dir");
+            Self(path)
+        }
+
+        fn path(&self) -> &Path {
+            &self.0
+        }
+    }
+
+    impl Drop for TempDir {
+        fn drop(&mut self) {
+            std::fs::remove_dir_all(&self.0).expect("removing the test temp dir");
+        }
+    }
+
+    fn package_metadata(source_dir: PathBuf) -> PackageMetadata {
+        PackageMetadata {
+            license: "Apache-2.0 WITH LLVM-exception".to_owned(),
+            authors: Vec::new(),
+            notices: BTreeMap::new(),
+            is_in_libstd: None,
+            source_dir: Some(source_dir),
+        }
+    }
+
+    #[test]
+    fn reads_notices_from_an_unvendored_path_dependency() {
+        let temp = TempDir::new();
+        let package_dir = temp.path().join("clif-to-wasm");
+        std::fs::create_dir_all(&package_dir).expect("creating the package dir");
+        std::fs::write(
+            package_dir.join("Cargo.toml"),
+            "[package]\nname = \"clif-to-wasm\"\nversion = \"0.3.0\"\n",
+        )
+        .expect("writing Cargo.toml");
+        std::fs::write(package_dir.join("LICENSE-APACHE"), "Apache License 2.0\n")
+            .expect("writing LICENSE-APACHE");
+        std::fs::write(package_dir.join("LICENSE-MIT"), "MIT License\n")
+            .expect("writing LICENSE-MIT");
+
+        let vendor = temp.path().join("vendor");
+        std::fs::create_dir_all(&vendor).expect("creating the empty vendor dir");
+        let package = Package {
+            name: "clif-to-wasm".to_owned(),
+            version: "0.3.0".to_owned(),
+        };
+        let mut metadata = package_metadata(package_dir.clone());
+
+        load_important_files(&package, &mut metadata, &vendor)
+            .expect("an out-of-tree package must be read from its own source dir");
+        assert_eq!(
+            metadata.notices.get("LICENSE-APACHE").map(String::as_str),
+            Some("Apache License 2.0\n")
+        );
+        assert_eq!(
+            metadata.notices.get("LICENSE-MIT").map(String::as_str),
+            Some("MIT License\n")
+        );
+    }
+
+    #[test]
+    fn prefers_a_vendored_copy_when_one_exists() {
+        let temp = TempDir::new();
+        let package_dir = temp.path().join("source");
+        let vendor_dir = temp.path().join("vendor").join("clif-to-wasm-0.3.0");
+        std::fs::create_dir_all(&package_dir).expect("creating the source dir");
+        std::fs::create_dir_all(&vendor_dir).expect("creating the vendor dir");
+        std::fs::write(package_dir.join("LICENSE-MIT"), "source license\n")
+            .expect("writing the source licence");
+        std::fs::write(vendor_dir.join("LICENSE-MIT"), "vendored license\n")
+            .expect("writing the vendored licence");
+
+        let package = Package {
+            name: "clif-to-wasm".to_owned(),
+            version: "0.3.0".to_owned(),
+        };
+        let mut metadata = package_metadata(package_dir);
+        load_important_files(
+            &package,
+            &mut metadata,
+            temp.path().join("vendor").as_path(),
+        )
+        .expect("a vendored package must still be read from the vendor dir");
+        assert_eq!(
+            metadata.notices.get("LICENSE-MIT").map(String::as_str),
+            Some("vendored license\n")
+        );
+    }
+
+    #[test]
+    fn reports_the_missing_source_directory() {
+        let temp = TempDir::new();
+        let package = Package {
+            name: "clif-to-wasm".to_owned(),
+            version: "0.3.0".to_owned(),
+        };
+        let mut metadata = package_metadata(temp.path().join("does-not-exist"));
+        let error = load_important_files(
+            &package,
+            &mut metadata,
+            temp.path().join("vendor").as_path(),
+        )
+        .expect_err("a package with neither vendor nor source must fail loudly");
+        assert!(
+            matches!(error, Error::Scraping(_)),
+            "unexpected error: {error:?}"
+        );
+    }
+}
