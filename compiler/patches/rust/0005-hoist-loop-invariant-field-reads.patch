--- /dev/null
+++ b/compiler/rustc_mir_transform/src/loop_field_hoist.rs
@@ -0,0 +1,413 @@
+//! Hoist loop-invariant field reads out of loops.
+//!
+//! `sroa` only promotes a local whose address is never taken, so a `Vec` local
+//! that was pushed to before a loop stays in its stack slot and every
+//! `vec[i]` reloads its pointer and length. This pass finds reads of scalar
+//! fields of a local that is not written and not mutably borrowed *inside the
+//! loop*, evaluates the read once in the loop preheader into a fresh local,
+//! and replaces the in-loop read with a copy of that local.
+//!
+//! The destination of the original assignment is left in place: the preheader
+//! writes the new temporary, not the destination, so a loop that runs zero
+//! times leaves the destination exactly as it was.
+//!
+//! Soundness relies on MIR having been borrow-checked:
+//!
+//! - A direct read of `base.field` cannot coexist with a live unique borrow of
+//!   `base`, so a borrow taken before the loop cannot mutate that field while
+//!   the loop reads it directly.
+//! - A shared borrow cannot mutate a `Freeze` base, which we require.
+//! - Raw pointers are not covered by borrow checking. A raw pointer to a local
+//!   (not through a dereference), a cast to a raw pointer from a reference,
+//!   and an integer-to-pointer cast can alias the fields we would hoist, so
+//!   any of those skips the function. Raw pointers into memory the local
+//!   points at do not alias its own fields and are allowed.
+//! - Any borrow of `base` created inside the loop, any move out of it, and any
+//!   direct, discriminant or storage write rejects the base, because those
+//!   change the value between iterations without a borrow conflict.
+//!
+//! Only loops that are part of a nest (nested in another loop, or containing
+//! one) are optimized. The preheader read is paid once per loop entry, so a
+//! single-level loop over a runtime-length collection can run too few times to
+//! pay for it; `expr::Env::set` regressed by 0.01% that way while the nested
+//! kernels (`nbody`, `b_alloc`) pay it back many times over.
+//!
+//! This is deliberately conservative: the calls that keep `Vec`'s address
+//! escaping limit what it can see until the cost-model inliner from Goal 1
+//! step 5b removes them. The pass is opt-in through the unstable flag
+//! `-Zmir-hoist-loop-field-reads`; it must not run in the compiler, sysroot or
+//! default benchmark builds.
+
+use rustc_data_structures::graph::dominators::Dominators;
+use rustc_index::bit_set::DenseBitSet;
+use rustc_middle::mir::*;
+use rustc_middle::ty::{self, TyCtxt};
+
+use crate::PassPolicy;
+use crate::patch::MirPatch;
+
+pub(super) struct LoopFieldHoist;
+
+impl<'tcx> crate::MirPass<'tcx> for LoopFieldHoist {
+    fn policy(&self, ctx: &crate::PassCtx<'_>) -> PassPolicy {
+        PassPolicy::optional(ctx.opts.unstable_opts.mir_hoist_loop_field_reads)
+    }
+
+    fn run_pass(&self, tcx: TyCtxt<'tcx>, body: &mut Body<'tcx>) {
+        use rustc_hir::def::DefKind;
+        if body.source.promoted.is_some()
+            || matches!(
+                tcx.def_kind(body.source.def_id()),
+                DefKind::Const | DefKind::Static { .. } | DefKind::AnonConst
+            )
+        {
+            return;
+        }
+
+        let reachable = reachable_blocks(body);
+        // A raw pointer to a local can alias `base` without any borrow-checker
+        // fact that would stop us. Without a points-to analysis, leave such
+        // functions alone; pointers into a buffer are not covered and do not
+        // alias a local's own fields.
+        if creates_aliasing_raw_pointer(body, &reachable) {
+            return;
+        }
+        let typing_env = ty::TypingEnv::post_analysis(tcx, body.source.def_id());
+        let dominators = body.basic_blocks.dominators().clone();
+        let mut loops = Vec::new();
+        for header in loop_headers(body, &dominators, &reachable) {
+            let blocks = loop_blocks(body, &dominators, &reachable, header);
+            if blocks.len() < 2 {
+                continue;
+            }
+            let mut members = DenseBitSet::new_empty(body.basic_blocks.len());
+            for bb in &blocks {
+                members.insert(*bb);
+            }
+            loops.push(Loop { header, blocks, members });
+        }
+        for (index, loop_) in loops.iter().enumerate() {
+            // Pay the preheader read only where the loop is part of a nest.
+            let nested = loops.iter().enumerate().any(|(other_index, other)| {
+                other_index != index && other.members.contains(loop_.header)
+            });
+            let contains_nested = loops.iter().enumerate().any(|(other_index, other)| {
+                other_index != index && loop_.members.contains(other.header)
+            });
+            if !nested && !contains_nested {
+                continue;
+            }
+            hoist_loop(tcx, body, typing_env, &dominators, &reachable, loop_);
+        }
+    }
+}
+
+struct Loop {
+    header: BasicBlock,
+    blocks: Vec<BasicBlock>,
+    members: DenseBitSet<BasicBlock>,
+}
+
+fn reachable_blocks(body: &Body<'_>) -> DenseBitSet<BasicBlock> {
+    let mut reachable = DenseBitSet::new_empty(body.basic_blocks.len());
+    for bb in body.basic_blocks.reverse_postorder() {
+        reachable.insert(*bb);
+    }
+    reachable
+}
+
+fn creates_aliasing_raw_pointer(
+    body: &Body<'_>,
+    reachable: &DenseBitSet<BasicBlock>,
+) -> bool {
+    for bb in body.basic_blocks.indices() {
+        if !reachable.contains(bb) {
+            continue;
+        }
+        for statement in &body[bb].statements {
+            let StatementKind::Assign(assign) = &statement.kind else {
+                continue;
+            };
+            match &assign.1 {
+                Rvalue::RawPtr(_, place) => {
+                    if !place
+                        .projection
+                        .iter()
+                        .any(|element| matches!(element, PlaceElem::Deref))
+                    {
+                        return true;
+                    }
+                }
+                Rvalue::Cast(_, operand, target) if target.is_raw_ptr() => {
+                    let (Operand::Copy(place) | Operand::Move(place)) = operand else {
+                        continue;
+                    };
+                    let ty = body.local_decls[place.local].ty;
+                    if ty.is_ref() || ty.is_integral() {
+                        return true;
+                    }
+                }
+                _ => {}
+            }
+        }
+    }
+    false
+}
+
+/// Loop headers with a backedge: a successor that dominates the block pointing
+/// at it.
+fn loop_headers(
+    body: &Body<'_>,
+    dominators: &Dominators<BasicBlock>,
+    reachable: &DenseBitSet<BasicBlock>,
+) -> Vec<BasicBlock> {
+    let mut headers = Vec::new();
+    for bb in body.basic_blocks.indices() {
+        if !reachable.contains(bb) {
+            continue;
+        }
+        for successor in body[bb].terminator().successors() {
+            if dominators.dominates(successor, bb) && !headers.contains(&successor) {
+                headers.push(successor);
+            }
+        }
+    }
+    headers
+}
+
+/// Blocks of the natural loop with `header`.
+fn loop_blocks(
+    body: &Body<'_>,
+    dominators: &Dominators<BasicBlock>,
+    reachable: &DenseBitSet<BasicBlock>,
+    header: BasicBlock,
+) -> Vec<BasicBlock> {
+    let mut in_loop: DenseBitSet<BasicBlock> = DenseBitSet::new_empty(body.basic_blocks.len());
+    in_loop.insert(header);
+    let mut stack = Vec::new();
+    for bb in body.basic_blocks.indices() {
+        if !reachable.contains(bb) {
+            continue;
+        }
+        for successor in body[bb].terminator().successors() {
+            if successor == header && dominators.dominates(header, bb) {
+                stack.push(bb);
+            }
+        }
+    }
+    while let Some(bb) = stack.pop() {
+        if in_loop.contains(bb) {
+            continue;
+        }
+        in_loop.insert(bb);
+        for predecessor in body.basic_blocks.predecessors()[bb].iter() {
+            if *predecessor != header
+                && reachable.contains(*predecessor)
+                && !in_loop.contains(*predecessor)
+                && dominators.dominates(header, *predecessor)
+            {
+                stack.push(*predecessor);
+            }
+        }
+    }
+    body.basic_blocks
+        .indices()
+        .filter(|bb| in_loop.contains(*bb))
+        .collect()
+}
+
+fn hoist_loop<'tcx>(
+    tcx: TyCtxt<'tcx>,
+    body: &mut Body<'tcx>,
+    typing_env: ty::TypingEnv<'tcx>,
+    dominators: &Dominators<BasicBlock>,
+    reachable: &DenseBitSet<BasicBlock>,
+    loop_: &Loop,
+) {
+    let Some(preheader) = unique_preheader(body, &loop_.blocks, loop_.header) else {
+        return;
+    };
+    let (written, escaped, has_inline_asm) = loop_effects(body, &loop_.blocks);
+    if has_inline_asm {
+        return;
+    }
+    let initialized = initialized_before(body, dominators, reachable, preheader);
+    let preheader_end = Location {
+        block: preheader,
+        statement_index: body[preheader].statements.len(),
+    };
+
+    let mut patch = MirPatch::new(body);
+    let mut moved = 0;
+    for bb in &loop_.blocks {
+        let bb = *bb;
+        if body[bb].is_cleanup {
+            continue;
+        }
+        for (index, statement) in body[bb].statements.iter().enumerate() {
+            let StatementKind::Assign(assign) = &statement.kind else {
+                continue;
+            };
+            let (destination, rvalue) = &**assign;
+            let Rvalue::Use(Operand::Copy(place), with_retag) = rvalue else {
+                continue;
+            };
+            if !destination.projection.is_empty() || place.projection.is_empty() {
+                continue;
+            }
+            if place
+                .projection
+                .iter()
+                .any(|element| !matches!(element, PlaceElem::Field(..)))
+            {
+                continue;
+            }
+            let base = place.local;
+            if written.contains(base)
+                || escaped.contains(base)
+                || !initialized.contains(base)
+                || !body.local_decls[base].ty.is_freeze(tcx, typing_env)
+            {
+                continue;
+            }
+            if !body.local_decls[destination.local].ty.is_scalar() {
+                continue;
+            }
+            let temporary = patch.new_temp(
+                body.local_decls[destination.local].ty,
+                statement.source_info.span,
+            );
+            patch.add_assign(
+                preheader_end,
+                temporary.into(),
+                Rvalue::Use(Operand::Copy(*place), WithRetag::No),
+            );
+            patch.add_statement(
+                Location {
+                    block: bb,
+                    statement_index: index,
+                },
+                StatementKind::Assign(Box::new((
+                    *destination,
+                    Rvalue::Use(Operand::Copy(temporary.into()), *with_retag),
+                ))),
+            );
+            patch.nop_statement(Location {
+                block: bb,
+                statement_index: index,
+            });
+            moved += 1;
+        }
+    }
+    if moved > 0 {
+        patch.apply(body);
+    }
+}
+
+fn unique_preheader(
+    body: &Body<'_>,
+    blocks: &[BasicBlock],
+    header: BasicBlock,
+) -> Option<BasicBlock> {
+    let outside: Vec<BasicBlock> = body.basic_blocks.predecessors()[header]
+        .iter()
+        .copied()
+        .filter(|bb| !blocks.contains(bb))
+        .collect();
+    let [preheader] = outside[..] else {
+        return None;
+    };
+    let TerminatorKind::Goto { target, .. } = &body[preheader].terminator().kind else {
+        return None;
+    };
+    (*target == header).then_some(preheader)
+}
+
+/// Locals written, moved out of or mutably borrowed inside the loop, and
+/// whether the loop contains inline asm (whose operands we do not analyse).
+fn loop_effects(
+    body: &Body<'_>,
+    blocks: &[BasicBlock],
+) -> (DenseBitSet<Local>, DenseBitSet<Local>, bool) {
+    let mut written: DenseBitSet<Local> = DenseBitSet::new_empty(body.local_decls.len());
+    let mut escaped: DenseBitSet<Local> = DenseBitSet::new_empty(body.local_decls.len());
+    let mut has_inline_asm = false;
+    for bb in blocks {
+        for statement in &body[*bb].statements {
+            match &statement.kind {
+                StatementKind::Assign(assign) => {
+                    let (place, rvalue) = &**assign;
+                    if !place.projection.is_empty() {
+                        written.insert(place.local);
+                    }
+                    match rvalue {
+                        Rvalue::Ref(_, _, referenced) | Rvalue::RawPtr(_, referenced) => {
+                            escaped.insert(referenced.local);
+                        }
+                        Rvalue::Use(Operand::Move(moved), _) => {
+                            written.insert(moved.local);
+                        }
+                        _ => {}
+                    }
+                }
+                StatementKind::SetDiscriminant { place, .. } => {
+                    written.insert(place.local);
+                }
+                StatementKind::StorageLive(local) | StatementKind::StorageDead(local) => {
+                    // Storage going in or out of scope inside the loop means
+                    // the preheader cannot see the same live value.
+                    written.insert(*local);
+                }
+                _ => {}
+            }
+        }
+        match &body[*bb].terminator().kind {
+            TerminatorKind::Call { args, .. } | TerminatorKind::TailCall { args, .. } => {
+                for argument in &**args {
+                    match &argument.node {
+                        Operand::Copy(place) if place.projection.is_empty() => {
+                            escaped.insert(place.local);
+                        }
+                        Operand::Move(place) => {
+                            written.insert(place.local);
+                        }
+                        _ => {}
+                    }
+                }
+            }
+            TerminatorKind::Drop { place, .. } => {
+                written.insert(place.local);
+            }
+            TerminatorKind::InlineAsm { .. } => has_inline_asm = true,
+            _ => {}
+        }
+    }
+    (written, escaped, has_inline_asm)
+}
+
+/// Locals with an assignment (or a function argument) in a block that
+/// dominates the preheader.
+fn initialized_before(
+    body: &Body<'_>,
+    dominators: &Dominators<BasicBlock>,
+    reachable: &DenseBitSet<BasicBlock>,
+    preheader: BasicBlock,
+) -> DenseBitSet<Local> {
+    let mut initialized: DenseBitSet<Local> = DenseBitSet::new_empty(body.local_decls.len());
+    for argument in body.args_iter() {
+        initialized.insert(argument);
+    }
+    for bb in body.basic_blocks.indices() {
+        if !reachable.contains(bb) || !dominators.dominates(bb, preheader) {
+            continue;
+        }
+        for statement in &body[bb].statements {
+            if let StatementKind::Assign(assign) = &statement.kind
+                && assign.0.projection.is_empty()
+            {
+                initialized.insert(assign.0.local);
+            }
+        }
+    }
+    initialized
+}
