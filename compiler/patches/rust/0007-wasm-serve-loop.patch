+/// Initial buffer for one host request. A request is small (an argument
+/// vector), so this normally avoids the `-n` retry.
+const SERVE_REQUEST_CAPACITY: usize = 4096;
+
+#[cfg(target_family = "wasm")]
+mod serve_imports {
+    #[link(wasm_import_module = "cogwasm")]
+    unsafe extern "C" {
+        /// Copy the next request into `buf` and return its length, `-n` when
+        /// the buffer must be at least `n` bytes, or `0` when serving is over.
+        pub fn next_request(buf: *mut u8, cap: usize) -> isize;
+        /// Report the exit code of the request that just finished.
+        pub fn finish(code: i32);
+    }
+}
+
+/// Read one request, retrying when the host's reply says the buffer was too
+/// small. The host keeps the request pending until it fits.
+#[cfg(target_family = "wasm")]
+fn next_request_bytes(mut capacity: usize) -> Option<Vec<u8>> {
+    loop {
+        capacity = capacity.max(1);
+        let mut buffer = vec![0u8; capacity];
+        let length = unsafe { serve_imports::next_request(buffer.as_mut_ptr(), buffer.len()) };
+        if length > 0 {
+            buffer.truncate(length.unsigned_abs());
+            return Some(buffer);
+        }
+        if length < 0 {
+            capacity = length.unsigned_abs();
+            continue;
+        }
+        return None;
+    }
+}
+
+#[cfg(not(target_family = "wasm"))]
+fn next_request_bytes(_capacity: usize) -> Option<Vec<u8>> {
+    eprintln!("rustc: COGWASM_SERVE is only supported when rustc is built for wasm32");
+    std::process::exit(1)
+}
+
+#[cfg(target_family = "wasm")]
+fn finish_request(code: i32) {
+    unsafe { serve_imports::finish(code) }
+}
+
+#[cfg(not(target_family = "wasm"))]
+fn finish_request(_code: i32) {}
+
+/// Serve requests until the host closes the channel, then return success.
+///
+/// Every request is an independent compiler entrypoint; the logger, signal
+/// handler and ICE hook above are process-wide and stay installed for the
+/// whole loop. `ICE_PATH`/`ICE_COLOR` keep the first request's configuration,
+/// as rustc's `OnceLock`s already define that behaviour, and the panic hook
+/// reports only the first panic.
+fn serve() -> ExitCode {
+    loop {
+        let Some(request) = next_request_bytes(SERVE_REQUEST_CAPACITY) else {
+            break;
+        };
+        let request = String::from_utf8_lossy(&request);
+        let mut args: Vec<String> = request.split('\0').map(str::to_owned).collect();
+        if args.last().is_some_and(String::is_empty) {
+            args.pop();
+        }
+
+        let start_time = Instant::now();
+        let start_rss = get_resident_set_size();
+        let mut callbacks = TimePassesCallbacks::default();
+        let code = match catch_fatal_errors(|| compiler_entrypoint(&args, &mut callbacks)) {
+            Ok(()) => 0,
+            Err(_) => 1,
+        };
+        if let Some(format) = callbacks.time_passes {
+            let end_rss = get_resident_set_size();
+            print_time_passes_entry("total", start_time.elapsed(), start_rss, end_rss, format);
+        }
+        finish_request(code);
+    }
+    ExitCode::SUCCESS
+}
+
 pub fn main() -> ExitCode {
     let start_time = Instant::now();
     let start_rss = get_resident_set_size();
