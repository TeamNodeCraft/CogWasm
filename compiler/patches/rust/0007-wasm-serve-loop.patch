index 000000000..3f620d770
--- /dev/null
+++ b/compiler/rustc_metadata/src/cache.rs
@@ -0,0 +1,72 @@
+//! A process-global cache of metadata file bytes for a long-lived rustc.
+//!
+//! A rustc built for wasm can serve many compile requests from one process
+//! when the host asks it to (`COGWASM_SERVE=1`). Every request otherwise
+//! re-reads the same sysroot and dependency `.rmeta`/`.rlib` files, which is
+//! a large part of a small compile's wall time and grows the guest's linear
+//! memory on every request.
+//!
+//! The cache is keyed by path, file length and modification time, so a
+//! rebuilt sysroot or dependency misses instead of serving stale bytes. Only
+//! whole metadata files are cached, and the environment is read once: without
+//! `COGWASM_SERVE=1` this module adds a branch and nothing else.
+
+use std::path::{Path, PathBuf};
+use std::sync::{Mutex, MutexGuard, OnceLock, PoisonError};
+use std::time::SystemTime;
+
+use rustc_data_structures::fx::FxHashMap;
+use rustc_data_structures::owned_slice::OwnedSlice;
+
+type CacheKey = (PathBuf, u64, SystemTime);
+type Cache = Mutex<FxHashMap<CacheKey, OwnedSlice>>;
+
+fn enabled() -> bool {
+    static ENABLED: OnceLock<bool> = OnceLock::new();
+    *ENABLED.get_or_init(|| matches!(std::env::var("COGWASM_SERVE").as_deref(), Ok("1")))
+}
+
+fn cache() -> &'static Cache {
+    static CACHE: OnceLock<Cache> = OnceLock::new();
+    CACHE.get_or_init(|| Mutex::new(FxHashMap::default()))
+}
+
+fn lock(cache: &'static Cache) -> MutexGuard<'static, FxHashMap<CacheKey, OwnedSlice>> {
+    // Entries are replaced whole and only ever read under this lock, so a
+    // panic elsewhere cannot leave the map structurally invalid.
+    cache.lock().unwrap_or_else(PoisonError::into_inner)
+}
+
+fn cacheable(path: &Path) -> bool {
+    matches!(path.extension().and_then(|extension| extension.to_str()), Some("rmeta" | "rlib"))
+}
+
+/// Return the bytes of `path`, reusing a previous read when the file metadata
+/// is unchanged.
+///
+/// On any metadata error, or when serving is off or the path is not a
+/// `.rmeta`/`.rlib`, this calls `load` and returns its result unchanged, so
+/// the caller's error messages and behaviour do not depend on the cache.
+pub fn cached_file_bytes<E>(
+    path: &Path,
+    load: impl FnOnce() -> Result<OwnedSlice, E>,
+) -> Result<OwnedSlice, E> {
+    if !enabled() || !cacheable(path) {
+        return load();
+    }
+    let Ok(metadata) = std::fs::metadata(path) else {
+        return load();
+    };
+    let Ok(modified) = metadata.modified() else {
+        return load();
+    };
+    let key = (path.to_path_buf(), metadata.len(), modified);
+
+    if let Some(bytes) = lock(cache()).get(&key).cloned() {
+        return Ok(bytes);
+    }
+
+    let bytes = load()?;
+    lock(cache()).insert(key, bytes.clone());
+    Ok(bytes)
+}
