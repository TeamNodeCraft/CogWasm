From 2f59a94fd5875f036be9eef76b09fb938225fe01 Mon Sep 17 00:00:00 2001
From: Stage C <stage-c@example.invalid>
Date: Wed, 18 Nov 2026 23:28:26 +1030
Subject: [PATCH] wasm: run compiler and codegen on the calling thread

wasm32-wasip1 has no threads. rustc always spawns its compiler thread in
rustc_interface::run_in_thread_with_globals, and rustc_codegen_ssa always
starts a coordinator thread with a producer/consumer handshake even when
there is a single codegen thread. Neither works without wasi-threads, which
Wasmtime 47 removed.

When compiled for wasm32, run the compiler closure directly on the calling
thread, and run codegen synchronously as units are submitted: optimize and
codegen each module, then finalize them in join. The guest stack is sized at
link time (-z stack-size) because there is no thread builder.

Tested end-to-end by building rustc.wasm for wasm32-wasip1 (non-threads) and
running the stage-A/B plugin pipeline under Wasmtime 50.0.2 with plain WASI
preview 1: eval(1,2,3,4) == 2.25, with no wasi:thread-spawn import.
---
 compiler/rustc_codegen_ssa/src/back/write.rs | 127 +++++++++++++++++--
 compiler/rustc_interface/src/util.rs         |  56 ++++----
 2 files changed, 149 insertions(+), 34 deletions(-)

diff --git a/compiler/rustc_codegen_ssa/src/back/write.rs b/compiler/rustc_codegen_ssa/src/back/write.rs
index 18968f0f8..dcc57ef47 100644
--- a/compiler/rustc_codegen_ssa/src/back/write.rs
+++ b/compiler/rustc_codegen_ssa/src/back/write.rs
@@ -445,6 +445,11 @@ pub(crate) fn start_async_codegen<B: WriteBackendMethods>(
         coordinator_send.clone(),
     );
 
+    let (future, sync) = match coordinator_thread {
+        CoordinatorFuture::Sync(sync) => (None, Some(std::cell::RefCell::new(sync))),
+        future => (Some(future), None),
+    };
+
     OngoingCodegen {
         backend,
 
@@ -452,7 +457,8 @@ pub(crate) fn start_async_codegen<B: WriteBackendMethods>(
         shared_emitter_main,
         coordinator: Coordinator {
             sender: coordinator_send,
-            future: Some(coordinator_thread),
+            future,
+            sync,
             phantom: PhantomData,
         },
         output_filenames: Arc::clone(tcx.output_filenames(())),
@@ -1211,7 +1217,7 @@ fn start_executing_work<B: WriteBackendMethods>(
     allocator_config: Arc<ModuleConfig>,
     mut allocator_module: Option<ModuleCodegen<B::Module>>,
     coordinator_send: Sender<Message<B>>,
-) -> thread::JoinHandle<Result<MaybeLtoModules<B>, ()>> {
+) -> CoordinatorFuture<B> {
     let sess = tcx.sess;
     let prof = sess.prof.clone();
 
@@ -1292,6 +1298,20 @@ fn start_executing_work<B: WriteBackendMethods>(
         pointer_size: tcx.data_layout.pointer_size(),
     };
 
+    // wasm32-wasip1 has no threads. There is no coordinator thread to overlap
+    // codegen with; codegen units are compiled as they are submitted and
+    // `join` finalizes them, all on the calling thread.
+    if cfg!(target_arch = "wasm32") {
+        return CoordinatorFuture::Sync(SyncCodegen {
+            cgcx,
+            prof,
+            shared_emitter,
+            allocator_config,
+            allocator_module,
+            compiled_modules: Vec::new(),
+        });
+    }
+
     // This is the "main loop" of parallel work happening for parallel codegen.
     // It's here that we manage parallelism, schedule work, and work with
     // messages coming from clients.
@@ -1779,10 +1799,12 @@ enum CodegenState {
             }),
         }))
     };
-    return std::thread::Builder::new()
-        .name("coordinator".to_owned())
-        .spawn(f)
-        .expect("failed to spawn coordinator thread");
+    return CoordinatorFuture::Thread(
+        std::thread::Builder::new()
+            .name("coordinator".to_owned())
+            .spawn(f)
+            .expect("failed to spawn coordinator thread"),
+    );
 
     // A heuristic that determines if we have enough LLVM WorkItems in the
     // queue so that the main thread can do LLVM work instead of codegen
@@ -2053,22 +2075,91 @@ fn check(&self, sess: &Session, blocking: bool) {
     }
 }
 
+/// On threadless targets (wasm) the coordinator's work is performed directly
+/// on the calling thread, one codegen unit at a time, with no channels.
+struct SyncCodegen<B: WriteBackendMethods> {
+    cgcx: CodegenContext,
+    prof: SelfProfilerRef,
+    shared_emitter: SharedEmitter,
+    allocator_config: Arc<ModuleConfig>,
+    allocator_module: Option<ModuleCodegen<B::Module>>,
+    compiled_modules: Vec<CompiledModule>,
+}
+
+impl<B: WriteBackendMethods> SyncCodegen<B> {
+    fn codegen(&mut self, mut module: ModuleCodegen<B::Module>) {
+        let config = Arc::clone(&self.cgcx.module_config);
+        B::optimize(&self.cgcx, &self.prof, &self.shared_emitter, &mut module, &config);
+        let compiled = B::codegen(&self.cgcx, &self.prof, &self.shared_emitter, module, &config);
+        self.compiled_modules.push(compiled);
+    }
+
+    fn finish(mut self) -> MaybeLtoModules<B> {
+        let allocator_module = self.allocator_module.take().map(|mut module| {
+            B::optimize(
+                &self.cgcx,
+                &self.prof,
+                &self.shared_emitter,
+                &mut module,
+                &self.allocator_config,
+            );
+            B::codegen(
+                &self.cgcx,
+                &self.prof,
+                &self.shared_emitter,
+                module,
+                &self.allocator_config,
+            )
+        });
+        MaybeLtoModules::NoLto(CompiledModules {
+            modules: self.compiled_modules,
+            allocator_module,
+        })
+    }
+}
+
+/// The result of starting codegen: either a running coordinator thread, or,
+/// on threadless targets (wasm), the synchronous codegen state.
+enum CoordinatorFuture<B: WriteBackendMethods> {
+    Thread(thread::JoinHandle<Result<MaybeLtoModules<B>, ()>>),
+    Sync(SyncCodegen<B>),
+}
+
 pub struct Coordinator<B: WriteBackendMethods> {
     sender: Sender<Message<B>>,
-    future: Option<thread::JoinHandle<Result<MaybeLtoModules<B>, ()>>>,
+    future: Option<CoordinatorFuture<B>>,
+    /// Present only when codegen runs synchronously (wasm, where there is no
+    /// coordinator thread).
+    sync: Option<std::cell::RefCell<SyncCodegen<B>>>,
     // Only used for the Message type.
     phantom: PhantomData<B>,
 }
 
 impl<B: WriteBackendMethods> Coordinator<B> {
     fn join(mut self) -> std::thread::Result<Result<MaybeLtoModules<B>, ()>> {
-        self.future.take().unwrap().join()
+        if let Some(sync) = self.sync.take() {
+            return Ok(Ok(sync.into_inner().finish()));
+        }
+        match self.future.take().unwrap() {
+            CoordinatorFuture::Thread(future) => future.join(),
+            CoordinatorFuture::Sync(sync) => Ok(Ok(sync.finish())),
+        }
+    }
+
+    /// Codegen a submitted module synchronously on wasm.
+    fn codegen_submitted_module(&self, module: ModuleCodegen<B::Module>, cost: u64) {
+        if let Some(sync) = &self.sync {
+            sync.borrow_mut().codegen(module);
+            return;
+        }
+        let llvm_work_item = WorkItem::Optimize(module);
+        drop(self.sender.send(Message::CodegenDone::<B> { llvm_work_item, cost }));
     }
 }
 
 impl<B: WriteBackendMethods> Drop for Coordinator<B> {
     fn drop(&mut self) {
-        if let Some(future) = self.future.take() {
+        if let Some(CoordinatorFuture::Thread(future)) = self.future.take() {
             // If we haven't joined yet, signal to the coordinator that it should spawn no more
             // work, and wait for worker threads to finish.
             drop(self.sender.send(Message::CodegenAborted::<B>));
@@ -2095,7 +2186,13 @@ pub fn join(
         incr_comp_session: Option<&IncrCompSession>,
         crate_info: &CrateInfo,
     ) -> (CompiledModules, WorkProductMap) {
-        self.shared_emitter_main.check(sess, true);
+        // With synchronous codegen the emitter is owned by the coordinator
+        // state until `join` consumes it, so a blocking check here would wait
+        // forever for the channel to close. The post-join checks below report
+        // the same diagnostics.
+        if self.coordinator.sync.is_none() {
+            self.shared_emitter_main.check(sess, true);
+        }
 
         let maybe_lto_modules = sess.time("join_worker_thread", || match self.coordinator.join() {
             Ok(Ok(maybe_lto_modules)) => maybe_lto_modules,
@@ -2176,6 +2273,10 @@ pub fn join(
     }
 
     pub(crate) fn codegen_finished(&self, tcx: TyCtxt<'_>) {
+        if self.coordinator.sync.is_some() {
+            self.check_for_errors(tcx.sess);
+            return;
+        }
         self.wait_for_signal_to_codegen_item();
         self.check_for_errors(tcx.sess);
         drop(self.coordinator.sender.send(Message::CodegenComplete::<B>));
@@ -2186,6 +2287,9 @@ pub(crate) fn check_for_errors(&self, sess: &Session) {
     }
 
     pub(crate) fn wait_for_signal_to_codegen_item(&self) {
+        if self.coordinator.sync.is_some() {
+            return;
+        }
         match self.codegen_worker_receive.recv() {
             Ok(CguMessage) => {
                 // Ok to proceed.
@@ -2203,8 +2307,7 @@ pub(crate) fn submit_codegened_module_to_llvm<B: WriteBackendMethods>(
     module: ModuleCodegen<B::Module>,
     cost: u64,
 ) {
-    let llvm_work_item = WorkItem::Optimize(module);
-    drop(coordinator.sender.send(Message::CodegenDone::<B> { llvm_work_item, cost }));
+    coordinator.codegen_submitted_module(module, cost);
 }
 
 pub(crate) fn submit_post_lto_module_to_llvm<B: WriteBackendMethods>(
diff --git a/compiler/rustc_interface/src/util.rs b/compiler/rustc_interface/src/util.rs
index cf639ca2c..6b5e1731b 100644
--- a/compiler/rustc_interface/src/util.rs
+++ b/compiler/rustc_interface/src/util.rs
@@ -179,36 +179,48 @@ fn run_in_thread_with_globals<F: FnOnce(CurrentGcx) -> R + Send, R: Send>(
     extra_symbols: &[&'static str],
     f: F,
 ) -> R {
+    // We build the session globals and run `f` in the same place, because
+    // `SessionGlobals` does not impl `Send` in the non-parallel compiler.
+    let run = move || {
+        rustc_span::create_session_globals_then(
+            edition,
+            extra_symbols,
+            Some(sm_inputs),
+            || f(CurrentGcx::new()),
+        )
+    };
+
+    // wasm32-wasip1 has no threads, so rustc cannot spawn its usual compiler
+    // thread. Run the compiler on the calling thread instead; its stack is
+    // fixed at link time, so `thread_stack_size` does not apply.
+    #[cfg(target_arch = "wasm32")]
+    {
+        let _ = thread_stack_size;
+        run()
+    }
+
     // The "thread pool" is a single spawned thread in the non-parallel
     // compiler. We run on a spawned thread instead of the main thread (a) to
     // provide control over the stack size, and (b) to increase similarity with
     // the parallel compiler, in particular to ensure there is no accidental
     // sharing of data between the main thread and the compilation thread
     // (which might cause problems for the parallel compiler).
-    let builder = thread::Builder::new().name("rustc".to_string()).stack_size(thread_stack_size);
+    #[cfg(not(target_arch = "wasm32"))]
+    {
+        let builder =
+            thread::Builder::new().name("rustc".to_string()).stack_size(thread_stack_size);
 
-    // We build the session globals and run `f` on the spawned thread, because
-    // `SessionGlobals` does not impl `Send` in the non-parallel compiler.
-    thread::scope(|s| {
-        // `unwrap` is ok here because `spawn_scoped` only panics if the thread
-        // name contains null bytes.
-        let r = builder
-            .spawn_scoped(s, move || {
-                rustc_span::create_session_globals_then(
-                    edition,
-                    extra_symbols,
-                    Some(sm_inputs),
-                    || f(CurrentGcx::new()),
-                )
-            })
-            .unwrap()
-            .join();
+        thread::scope(|s| {
+            // `unwrap` is ok here because `spawn_scoped` only panics if the thread
+            // name contains null bytes.
+            let r = builder.spawn_scoped(s, run).unwrap().join();
 
-        match r {
-            Ok(v) => v,
-            Err(e) => std::panic::resume_unwind(e),
-        }
-    })
+            match r {
+                Ok(v) => v,
+                Err(e) => std::panic::resume_unwind(e),
+            }
+        })
+    }
 }
 
 pub(crate) fn run_in_thread_pool_with_globals<F: FnOnce(CurrentGcx) -> R + Send, R: Send>(
