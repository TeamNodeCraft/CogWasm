+++ b/compiler/rustc_mir_transform/src/inline_wasm.rs
@@ -0,0 +1,319 @@
+//! Inline loop-contained calls that rustc's cost model declines.
+//!
+//! Every call in the wasm we emit is expensive: arguments and results travel
+//! through linear memory or a stack slot rather than registers, and a call
+//! blocks the later MIR passes (SROA, reference propagation) from seeing the
+//! callee's state. Iterator and string code is a chain of small calls per
+//! element, so leaving even a few of them out of line keeps the iterator state
+//! in memory and the per-element work in calls.
+//!
+//! rustc's own inliner runs before this pass with a size-based cost model that
+//! is tuned for LLVM, which has a cheap register ABI and an inliner of its own.
+//! Its default threshold declines calls that this target wants inline. This
+//! pass reuses the inlining machinery and only changes the decision:
+//!
+//! - A call site inside a loop in the caller's CFG gets a much higher cost
+//!   threshold. Calls outside loops are left to rustc's inliner, so cold code
+//!   does not pay the code-size and compile-time cost.
+//! - A callee that takes a `&mut`/`*mut` argument gets 400 rather than 200:
+//!   the call forces the caller local behind that pointer into linear memory,
+//!   and inlining it is what lets the promotion passes see the local again.
+//! - Inlining stops once the caller has grown past a fixed multiple of its
+//!   original block count, so a chain of calls cannot blow up the body.
+//!
+//! The pass runs after the normal inliner, so it only sees calls that rustc
+//! declined. It is opt-in through the unstable flag `-Zmir-inline-wasm`: the
+//! growth budget and the loop threshold are first approximations, and the
+//! compiler, sysroot and default benchmark builds must not run it until the
+//! suite measurement says they should.
+
+use std::ops::Range;
+
+use rustc_attr_ir::InlineAttr;
+use rustc_hir::def_id::DefId;
+use rustc_index::IndexVec;
+use rustc_middle::middle::codegen_fn_attrs::CodegenFnAttrs;
+use rustc_middle::mir::visit::Visitor;
+use rustc_middle::mir::*;
+use rustc_middle::ty::{self, TyCtxt};
+use tracing::debug;
+
+use crate::cost_checker::{CostChecker, is_call_like};
+use crate::inline::{CallSite, Inliner, inline, process_blocks};
+use crate::simplify::simplify_cfg;
+use crate::{PassCtx, PassPolicy};
+
+/// The history depth mirrors `inline.rs`. The top-down limit is higher here:
+/// the iterator chain is nested, and the growth budget rather than this limit
+/// is what bounds the body.
+const HISTORY_DEPTH_LIMIT: usize = 20;
+const TOP_DOWN_DEPTH_LIMIT: usize = 20;
+
+/// How many times the caller's original block count the pass may grow it to.
+const GROWTH_FACTOR: usize = 4;
+
+/// The cost threshold for a call site inside a loop. Units are the cost
+/// checker's: an instruction is 5, a call 25. The string iterator chain
+/// (`CharIndices::next` and friends) is fully inlined from 200 up; 150 leaves
+/// it alone. 200 matches the 300 setting on `strings` while producing a
+/// smaller module there and in `collections`, and it avoids the `int_loops`
+/// layout regression that the extra inlining at 300 causes.
+const DEFAULT_LOOP_THRESHOLD: usize = 200;
+
+/// The threshold for a callee that borrows an argument mutably.
+///
+/// A call that takes `&mut` of a caller local forces that local into linear
+/// memory for the whole function: cg_clif keeps a local in an SSA variable
+/// only when no `Rvalue::Ref`/`RawPtr` roots at it, and `sroa` excludes the
+/// local too. Inlining the call is the only way to remove the borrow without
+/// new alias analysis. `next_code_point(&mut Iter<u8>)` costs 370, so 400
+/// admits it at the `split_whitespace` call site (native MIR A/B: the
+/// address-taken `SplitWhitespace` disappears, and the static count of
+/// accesses to address-taken locals over the body's loop blocks falls from
+/// 53 to 7) while leaving the shared/by-value helpers that grow `nbody`
+/// alone.
+const MUT_BORROW_THRESHOLD: usize = 400;
+
+pub(super) struct InlineWasm;
+
+/// Whether the body has a back edge (a successor that dominates the block
+/// pointing at it), i.e. any loop at all.
+fn has_loop(body: &Body<'_>) -> bool {
+    let dominators = body.basic_blocks.dominators();
+    body.basic_blocks
+        .indices()
+        .any(|bb| body[bb].terminator().successors().any(|to| dominators.dominates(to, bb)))
+}
+
+impl<'tcx> crate::MirPass<'tcx> for InlineWasm {
+    fn policy(&self, ctx: &PassCtx<'_>) -> PassPolicy {
+        PassPolicy::optional(ctx.opts.unstable_opts.mir_inline_wasm)
+    }
+
+    fn run_pass(&self, tcx: TyCtxt<'tcx>, body: &mut Body<'tcx>) {
+        // Every decision this pass makes needs a loop, so a body without a back
+        // edge has nothing to do. Skipping it avoids running the inliner over
+        // the many loop-free functions in a crate.
+        if !has_loop(body) {
+            return;
+        }
+        if inline::<WasmInliner<'tcx>>(tcx, body) {
+            debug!("running simplify cfg on {:?}", body.source);
+            simplify_cfg(tcx, body);
+        }
+    }
+}
+
+struct WasmInliner<'tcx> {
+    tcx: TyCtxt<'tcx>,
+    typing_env: ty::TypingEnv<'tcx>,
+    /// `DefId` of the caller.
+    def_id: DefId,
+    /// Stack of inlined instances, to stop polymorphic recursion.
+    history: Vec<DefId>,
+    /// How many multi-call bodies have been inlined for the top-level call.
+    /// Limits super-linear growth, like the normal inliner's counter.
+    top_down_counter: usize,
+    /// Indicates that the caller body has been modified.
+    changed: bool,
+    /// Whether each caller block is in a cycle of the CFG. Blocks created by
+    /// inlining inherit the flag of the call site they replace.
+    in_loop: IndexVec<BasicBlock, bool>,
+    /// The caller's block count, and the count at which inlining stops.
+    current_blocks: usize,
+    max_blocks: usize,
+}
+
+impl<'tcx> WasmInliner<'tcx> {
+    fn past_depth_limit(&self) -> bool {
+        self.history.len() > HISTORY_DEPTH_LIMIT || self.top_down_counter > TOP_DOWN_DEPTH_LIMIT
+    }
+
+    fn threshold(&self) -> usize {
+        self.tcx
+            .sess
+            .opts
+            .unstable_opts
+            .mir_inline_wasm_threshold
+            .unwrap_or(DEFAULT_LOOP_THRESHOLD)
+    }
+
+    /// Blocks in a natural loop: every block a loop header dominates, where a
+    /// header is a successor that dominates the block pointing at it.
+    fn loop_membership(body: &Body<'tcx>) -> IndexVec<BasicBlock, bool> {
+        let dominators = body.basic_blocks.dominators();
+        let mut in_loop = IndexVec::from_elem_n(false, body.basic_blocks.len());
+        for bb in body.basic_blocks.indices() {
+            for header in body[bb].terminator().successors() {
+                if !dominators.dominates(header, bb) {
+                    continue;
+                }
+                for member in body.basic_blocks.indices() {
+                    if dominators.dominates(header, member) {
+                        in_loop[member] = true;
+                    }
+                }
+            }
+        }
+        in_loop
+    }
+}
+
+impl<'tcx> Inliner<'tcx> for WasmInliner<'tcx> {
+    fn new(tcx: TyCtxt<'tcx>, def_id: DefId, body: &Body<'tcx>) -> Self {
+        let initial_blocks = body.basic_blocks.len();
+        Self {
+            tcx,
+            typing_env: body.typing_env(tcx),
+            def_id,
+            history: Vec::new(),
+            top_down_counter: 0,
+            changed: false,
+            in_loop: Self::loop_membership(body),
+            current_blocks: initial_blocks,
+            max_blocks: initial_blocks.saturating_mul(GROWTH_FACTOR),
+        }
+    }
+
+    fn tcx(&self) -> TyCtxt<'tcx> {
+        self.tcx
+    }
+
+    fn typing_env(&self) -> ty::TypingEnv<'tcx> {
+        self.typing_env
+    }
+
+    fn history(&self) -> &[DefId] {
+        &self.history
+    }
+
+    fn caller_def_id(&self) -> DefId {
+        self.def_id
+    }
+
+    fn changed(self) -> bool {
+        self.changed
+    }
+
+    fn should_inline_for_callee(&self, _: DefId) -> bool {
+        true
+    }
+
+    fn check_codegen_attributes_extra(
+        &self,
+        callee_attrs: &CodegenFnAttrs,
+    ) -> Result<(), &'static str> {
+        if self.past_depth_limit() && matches!(callee_attrs.inline, InlineAttr::None) {
+            Err("Past depth limit so not inspecting unmarked callee")
+        } else {
+            Ok(())
+        }
+    }
+
+    fn check_caller_mir_body(&self, body: &Body<'tcx>) -> bool {
+        // Coroutine bodies are used for layout, so inlining into them can
+        // create a query cycle.
+        body.coroutine.is_none()
+    }
+
+    fn check_callee_mir_body(
+        &self,
+        callsite: &CallSite<'tcx>,
+        callee_body: &Body<'tcx>,
+        callee_attrs: &CodegenFnAttrs,
+    ) -> Result<(), &'static str> {
+        let tcx = self.tcx;
+
+        if callee_body.tainted_by_errors.is_some() {
+            return Err("body has errors");
+        }
+        if self.past_depth_limit() && callee_body.basic_blocks.len() > 1 {
+            return Err("Not inlining multi-block body as we're past a depth limit");
+        }
+        if !self.in_loop.get(callsite.block).copied().unwrap_or(false) {
+            return Err("call site is outside a loop");
+        }
+        if self.current_blocks > self.max_blocks {
+            return Err("caller growth budget exhausted");
+        }
+
+        let caller_attrs = tcx.codegen_fn_attrs(self.caller_def_id());
+        if callee_attrs.instruction_set != caller_attrs.instruction_set
+            && callee_body
+                .basic_blocks
+                .iter()
+                .any(|bb| matches!(bb.terminator().kind, TerminatorKind::InlineAsm { .. }))
+        {
+            return Err("cannot move inline-asm across instruction sets");
+        }
+
+        let mut checker =
+            CostChecker::new(tcx, self.typing_env(), Some(callsite.callee), callee_body);
+        checker.add_function_level_costs();
+        checker.visit_body(callee_body);
+        let cost = checker.cost();
+        let takes_mut_borrow = callee_body
+            .local_decls
+            .iter()
+            .skip(1)
+            .take(callee_body.arg_count)
+            .any(|decl| {
+                matches!(
+                    decl.ty.kind(),
+                    ty::Ref(_, _, ty::Mutability::Mut) | ty::RawPtr(_, ty::Mutability::Mut)
+                )
+            });
+        let threshold = if takes_mut_borrow {
+            self.threshold().max(MUT_BORROW_THRESHOLD)
+        } else {
+            self.threshold()
+        };
+        if cost <= threshold {
+            debug!(
+                "inlining {:?} [cost={cost} <= threshold={threshold}, inline={:?}]",
+                callsite.callee, callee_attrs.inline
+            );
+            Ok(())
+        } else {
+            debug!(
+                "not inlining {:?} [cost={cost} > threshold={threshold}, inline={:?}]",
+                callsite.callee, callee_attrs.inline
+            );
+            Err("cost above the wasm inliner threshold")
+        }
+    }
+
+    fn on_inline_success(
+        &mut self,
+        callsite: &CallSite<'tcx>,
+        caller_body: &mut Body<'tcx>,
+        new_blocks: Range<BasicBlock>,
+    ) {
+        self.changed = true;
+        self.current_blocks = caller_body.basic_blocks.len();
+
+        let new_calls_count = new_blocks
+            .clone()
+            .filter(|&bb| is_call_like(caller_body.basic_blocks[bb].terminator()))
+            .count();
+        if new_calls_count > 1 {
+            self.top_down_counter += 1;
+        }
+
+        self.history.push(callsite.callee.def_id());
+
+        // The inlined blocks are inside the loop the call site was in.
+        let in_loop = self.in_loop[callsite.block];
+        self.in_loop.resize(caller_body.basic_blocks.len(), false);
+        for bb in new_blocks.clone() {
+            self.in_loop[bb] = in_loop;
+        }
+
+        process_blocks(self, caller_body, new_blocks);
+        self.history.pop();
+    }
+
+    fn on_inline_failure(&self, callsite: &CallSite<'tcx>, reason: &'static str) {
+        debug!("not inlining {:?} [{reason}]", callsite.callee);
+    }
+}
