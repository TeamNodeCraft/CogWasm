diff --git a/build_system/tests.rs b/build_system/tests.rs
index 5d705776..6b6775b3 100644
--- a/build_system/tests.rs
+++ b/build_system/tests.rs
@@ -88,6 +88,25 @@ const fn jit_bin(config: &'static str, source: &'static str, args: &'static str)
         &[],
     ),
     TestCase::build_bin_and_run("aot.float-minmax-pass", "example/float-minmax-pass.rs", &[]),
+    TestCase::custom("aot.wasm_memory_intrinsics", &|runner| {
+        // Compile-only: core::arch::wasm32::{memory_grow,memory_size} lower to
+        // LLVM intrinsics that cg_clif must handle. Other targets do not have
+        // them, so the test only applies to wasm.
+        if !runner.target_compiler.target.starts_with("wasm32") {
+            return;
+        }
+        let mut cmd =
+            runner.rustc_command(["example/wasm-memory-intrinsics.rs", "--crate-type", "lib"]);
+        let output = cmd.output().unwrap();
+        let stderr = String::from_utf8_lossy(&output.stderr);
+        assert!(output.status.success(), "compilation failed:\n{stderr}");
+        // The fallback for an unknown LLVM intrinsic only warns and emits a
+        // trap, so a successful compile is not enough.
+        assert!(
+            !stderr.contains("unsupported llvm intrinsic"),
+            "wasm memory intrinsic was replaced with a trap:\n{stderr}"
+        );
+    }),
     TestCase::custom("aot.powi_libcall_signature", &|runner| {
         let mut cmd = runner.rustc_command(["example/powi-libcall-signature.rs"]);
         let output = cmd.output().unwrap();
