+//! Compiling for wasm targets through `clif-to-wasm`, which turns
+//! the CLIF of each function into wasm and writes relocatable wasm objects
+//! that `wasm-ld` or `wild` link with the (LLVM-compiled) sysroot.
+
+use cranelift_codegen::isa::OwnedTargetIsa;
+use cranelift_codegen::settings;
+use clif_to_wasm::AddressType;
+use clif_to_wasm::object_module::{
+    ObjectOptions, THREADS_FEATURES, WasmObjectModule, frontend_isa,
+};
+use rustc_data_structures::unord::{ExtendUnord, UnordMap};
+use rustc_middle::ty::{Instance, TyCtxt};
+use rustc_session::Session;
+use rustc_span::def_id::LOCAL_CRATE;
+use rustc_target::spec::Arch;
+
+pub(crate) fn is_wasm(sess: &Session) -> bool {
+    matches!(sess.target.arch, Arch::Wasm32 | Arch::Wasm64)
+}
+
+fn address_type(sess: &Session) -> AddressType {
+    if sess.target.arch == Arch::Wasm64 { AddressType::I64 } else { AddressType::I32 }
+}
+
+/// The target features enabled by the target spec and `-Ctarget-feature`.
+pub(crate) fn target_features(sess: &Session) -> Vec<String> {
+    target_features_of(&sess.target, &sess.opts.cg.target_feature)
+}
+
+pub(crate) fn target_features_of(target: &rustc_target::spec::Target, cg: &str) -> Vec<String> {
+    let mut features: Vec<String> = Vec::new();
+    for list in [&*target.options.features, cg] {
+        for f in list.split(',') {
+            if let Some(name) = f.strip_prefix('+') {
+                if !features.iter().any(|x| x == name) {
+                    features.push(name.to_owned());
+                }
+            } else if let Some(name) = f.strip_prefix('-') {
+                features.retain(|x| x != name);
+            }
+        }
+    }
+    features
+}
+
+/// Whether the program has threads (shared memory and TLS).
+pub(crate) fn threads(sess: &Session) -> bool {
+    target_features(sess).iter().any(|f| f == "atomics")
+}
+
+pub(crate) fn build_isa(sess: &Session, flags: settings::Flags) -> OwnedTargetIsa {
+    frontend_isa(flags, address_type(sess))
+        .unwrap_or_else(|err| sess.dcx().fatal(format!("failed to build TargetIsa: {err}")))
+}
+
+/// The functions imported with `#[link(wasm_import_module = "...")]`: for
+/// each (mangled) symbol name, the wasm module and field it is imported as,
+/// named as rustc_codegen_llvm names them.
+fn wasm_import_names(tcx: TyCtxt<'_>) -> UnordMap<String, (String, String)> {
+    let mut names = UnordMap::default();
+    for &cnum in tcx.crates(()).iter().chain([&LOCAL_CRATE]) {
+        names.extend_unord(tcx.wasm_import_module_map(cnum).items().map(|(&def_id, module)| {
+            let symbol = tcx.symbol_name(Instance::mono(tcx, def_id)).name.to_owned();
+            let field =
+                tcx.codegen_fn_attrs(def_id).symbol_name.unwrap_or_else(|| tcx.item_name(def_id));
+            (symbol, (module.clone(), field.to_string()))
+        }));
+    }
+    names
+}
+
+pub(crate) fn make_module(tcx: TyCtxt<'_>, isa: OwnedTargetIsa) -> WasmObjectModule {
+    let sess = tcx.sess;
+    let mut config = clif_to_wasm::Config::default();
+    config.module.address_type = address_type(sess);
+    // The sysroot is compiled by LLVM: use its convention for multiple
+    // return values.
+    config.module.demote_multi_results = true;
+    let threads = threads(sess);
+    let mut features: Vec<String> = THREADS_FEATURES.iter().map(|&f| f.to_owned()).collect();
+    if !threads {
+        features.retain(|f| f != "atomics");
+    }
+    for f in target_features(sess) {
+        if !features.contains(&f) {
+            features.push(f);
+        }
+    }
+    let mut options = ObjectOptions::default();
+    options.config = config;
+    options.threads = threads;
+    options.features = features;
+    // Functions using what the backend does not support yet trap when
+    // called, with a warning at compile time.
+    options.stub_unsupported = std::env::var("CG_CLIF_WASM_STRICT").as_deref() != Ok("1");
+    let names = wasm_import_names(tcx);
+    options.import_names = Box::new(move |symbol| names.get(symbol).cloned());
+    WasmObjectModule::new(isa, options)
+}
