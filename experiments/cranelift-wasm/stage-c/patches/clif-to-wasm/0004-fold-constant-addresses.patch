         Ok(())
     }
 
+    /// Whether the wasm load already zero-extends the result to the full width
+    /// of `ty`, making a following `mask(ty)` redundant.
+    fn load_zero_extends(op: Opcode, ty: Type) -> bool {
+        matches!(
+            (op, ty),
+            (Opcode::Load, types::I8 | types::I16)
+                | (Opcode::Uload8, types::I8 | types::I16)
+                | (Opcode::Uload16, types::I16)
+        )
+    }
+
     /// Lower a scalar memory load (`Load`, `Uload*`, `Sload*`), handling both
     /// native little-endian and byte-swapped big-endian accesses.
     fn scalar_load(&mut self, op: Opcode, ty: Type, flags: MemFlags, offset: i32) -> Result<()> {
@@ -869,7 +880,11 @@
                 (types::I64, types::I64) => {}
                 (_, types::I64) if signed => self.ins(I::I64ExtendI32S),
                 (_, types::I64) => self.ins(I::I64ExtendI32U),
-                (_, types::I8 | types::I16 | types::I32 | types::F16) => self.mask(ty),
+                (_, types::I8 | types::I16 | types::I32 | types::F16) => {
+                    if signed || !Self::load_zero_extends(op, ty) {
+                        self.mask(ty);
+                    }
+                }
                 _ => return error::unsupported(format!("{op}.{ty}")),
             }
             return Ok(());
@@ -897,7 +912,9 @@
         };
         let m = self.memarg(off, flags, size);
         self.ins(i(m));
-        self.mask(ty);
+        if !Self::load_zero_extends(op, ty) {
+            self.mask(ty);
+        }
         Ok(())
     }
 
diff --git a/tests/address.rs b/tests/address.rs
new file mode 100644
--- /dev/null
+++ b/tests/address.rs
@@ -0,0 +1,200 @@
+//! Constant address folding: an inlined `iadd(base, iconst)` becomes a wasm
+//! memarg offset; wrapping and unknown bases must not fold.
+
+mod harness;
+
+use clif_to_wasm::Config;
+use cranelift_codegen::data_value::DataValue;
+use cranelift_codegen::ir::types;
+use wasmparser::{Operator, Parser, Payload};
+
+#[derive(Default)]
+struct Counts {
+    i32_add: usize,
+    i32_and: usize,
+    memarg_offsets: Vec<u64>,
+}
+
+fn counts(wasm: &[u8]) -> Counts {
+    let mut c = Counts::default();
+    for payload in Parser::new(0).parse_all(wasm) {
+        if let Payload::CodeSectionEntry(body) = payload.unwrap() {
+            for op in body.get_operators_reader().unwrap() {
+                match op.unwrap() {
+                    Operator::I32Add => c.i32_add += 1,
+                    Operator::I32And => c.i32_and += 1,
+                    Operator::I32Load { memarg } => c.memarg_offsets.push(memarg.offset),
+                    Operator::I32Store { memarg } => c.memarg_offsets.push(memarg.offset),
+                    _ => {}
+                }
+            }
+        }
+    }
+    c
+}
+
+const FOLD_CONST: &str = "
+function %fold_const() -> i32 {
+block0:
+    v0 = iconst.i32 4096
+    v1 = iconst.i32 24
+    v2 = iadd v0, v1
+    v3 = iconst.i32 777
+    store.i32 v3, v2
+    v4 = iconst.i32 4096
+    v5 = iconst.i32 24
+    v6 = iadd v4, v5
+    v7 = load.i32 v6
+    return v7
+}
+";
+
+#[test]
+fn constant_address_is_folded_into_the_memarg() {
+    let funcs = cranelift_reader::parse_functions(FOLD_CONST).unwrap();
+    let (wasm, unsupported) = harness::compile_module(&funcs, &Config::default());
+    assert!(unsupported.is_empty(), "{unsupported:?}");
+    harness::validate(&wasm).unwrap();
+
+    let c = counts(&wasm);
+    assert_eq!(c.i32_add, 0, "the constant adds must be gone");
+    assert_eq!(c.memarg_offsets, [24, 24], "both accesses use offset 24");
+
+    let runner = harness::Runner::new(&wasm).unwrap();
+    let result = runner
+        .call("fold_const", &[], &[types::I32])
+        .unwrap()
+        .expect("returns");
+    assert_eq!(result, vec![DataValue::I32(777)]);
+}
+
+const FOLD_BOUNDED: &str = "
+function %fold_bounded(i32) -> i32 {
+block0(v0: i32):
+    v1 = iconst.i32 255
+    v2 = band v0, v1
+    v3 = iconst.i32 8
+    v4 = iadd v2, v3
+    v5 = iconst.i32 777
+    store.i32 v5, v4
+    v6 = iconst.i32 255
+    v7 = band v0, v6
+    v8 = iconst.i32 8
+    v9 = iadd v7, v8
+    v10 = load.i32 v9
+    return v10
+}
+";
+
+#[test]
+fn bounded_dynamic_address_is_folded() {
+    let funcs = cranelift_reader::parse_functions(FOLD_BOUNDED).unwrap();
+    let (wasm, unsupported) = harness::compile_module(&funcs, &Config::default());
+    assert!(unsupported.is_empty(), "{unsupported:?}");
+    harness::validate(&wasm).unwrap();
+
+    let c = counts(&wasm);
+    assert_eq!(c.i32_add, 0, "base <= 255, so base + 8 cannot wrap");
+    assert!(c.memarg_offsets.iter().all(|&o| o == 8));
+
+    let runner = harness::Runner::new(&wasm).unwrap();
+    for x in [0u32, 0xffff_ff00, 0xffff_ffff] {
+        let result = runner
+            .call("fold_bounded", &[DataValue::I32(x as i32)], &[types::I32])
+            .unwrap()
+            .expect("returns");
+        assert_eq!(result, vec![DataValue::I32(777)], "x = {x:#x}");
+    }
+}
+
+const OVERFLOW: &str = "
+function %no_fold_overflow() -> i32 {
+block0:
+    v0 = iconst.i32 -16
+    v1 = iconst.i32 32
+    v2 = iadd v0, v1
+    v3 = iconst.i32 16
+    v4 = iconst.i32 12345
+    store.i32 v4, v3
+    v5 = load.i32 v2
+    return v5
+}
+";
+
+#[test]
+fn wrapping_address_is_not_folded() {
+    let funcs = cranelift_reader::parse_functions(OVERFLOW).unwrap();
+    let (wasm, unsupported) = harness::compile_module(&funcs, &Config::default());
+    assert!(unsupported.is_empty(), "{unsupported:?}");
+    harness::validate(&wasm).unwrap();
+
+    let c = counts(&wasm);
+    assert_eq!(c.i32_add, 1, "the wrapping add must remain");
+    assert!(!c.memarg_offsets.contains(&32), "must not use offset 32");
+
+    let runner = harness::Runner::new(&wasm).unwrap();
+    let result = runner
+        .call("no_fold_overflow", &[], &[types::I32])
+        .unwrap()
+        .expect("the wrapped load is in bounds");
+    assert_eq!(result, vec![DataValue::I32(12345)]);
+}
+
+const UNBOUNDED: &str = "
+function %no_fold_unbounded(i32) -> i32 {
+block0(v0: i32):
+    v1 = iconst.i32 8
+    v2 = iadd v0, v1
+    v3 = load.i32 v2
+    return v3
+}
+";
+
+#[test]
+fn unbounded_address_is_not_folded() {
+    let funcs = cranelift_reader::parse_functions(UNBOUNDED).unwrap();
+    let (wasm, unsupported) = harness::compile_module(&funcs, &Config::default());
+    assert!(unsupported.is_empty(), "{unsupported:?}");
+    harness::validate(&wasm).unwrap();
+    assert_eq!(counts(&wasm).i32_add, 1);
+}
+
+const NARROW_LOAD: &str = "
+function %narrow(i32) -> i32 {
+block0(v0: i32):
+    v1 = load.i8 v0
+    return v1
+}
+";
+
+const NARROW_SIGNED_LOAD: &str = "
+function %narrow_signed(i32) -> i32 {
+block0(v0: i32):
+    v1 = sload8.i16 v0
+    v2 = uextend.i32 v1
+    return v2
+}
+";
+
+#[test]
+fn unsigned_narrow_load_has_no_redundant_mask() {
+    let funcs = cranelift_reader::parse_functions(NARROW_LOAD).unwrap();
+    let (wasm, unsupported) = harness::compile_module(&funcs, &Config::default());
+    assert!(unsupported.is_empty(), "{unsupported:?}");
+    harness::validate(&wasm).unwrap();
+    assert_eq!(
+        counts(&wasm).i32_and,
+        0,
+        "i32.load8_u already zero-extends to i32"
+    );
+
+    let funcs = cranelift_reader::parse_functions(NARROW_SIGNED_LOAD).unwrap();
+    let (wasm, unsupported) = harness::compile_module(&funcs, &Config::default());
+    assert!(unsupported.is_empty(), "{unsupported:?}");
+    harness::validate(&wasm).unwrap();
+    assert_eq!(
+        counts(&wasm).i32_and,
+        1,
+        "a signed narrow load still needs the mask for the narrow representation"
+    );
+}
