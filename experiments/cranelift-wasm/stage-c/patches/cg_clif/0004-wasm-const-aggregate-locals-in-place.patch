+/// Make a [`CPlace`] that addresses a constant aggregate in place.
+///
+/// The constant's bytes already live in a read-only data allocation. Only
+/// `ConstValue::Indirect` lowers to a by-reference [`CValue`]; scalar
+/// constants are handled by the normal SSA/stack-slot path.
+fn make_const_local_place<'tcx>(
+    fx: &mut FunctionCx<'_, '_, 'tcx>,
+    constant: &ConstOperand<'tcx>,
+    layout: TyAndLayout<'tcx>,
+) -> Option<CPlace<'tcx>> {
+    if !layout.is_sized()
+        || layout.is_zst()
+        || !matches!(layout.backend_repr, BackendRepr::Memory { .. })
+        || layout.ty.needs_drop(fx.tcx, fx.typing_env())
+        || !layout.ty.is_freeze(fx.tcx, fx.typing_env())
+    {
+        return None;
+    }
+    let (const_val, ty) = crate::constant::eval_mir_constant(fx, constant);
+    if !matches!(const_val, ConstValue::Indirect { .. }) {
+        return None;
+    }
+    let cvalue = crate::constant::codegen_const_value(fx, const_val, ty);
+    let (ptr, extra) = cvalue.try_to_ptr()?;
+    Some(match extra {
+        Some(extra) => CPlace::for_ptr_with_extra(ptr, extra, layout),
+        None => CPlace::for_ptr(ptr, layout),
+    })
+}
+
 /// Make a [`CPlace`] capable of holding value of the specified type.
 fn make_local_place<'tcx>(
     fx: &mut FunctionCx<'_, '_, 'tcx>,
