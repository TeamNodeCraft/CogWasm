+/// Find locals whose only write is a single assignment of a constant aggregate.
+///
+/// Such a local can be addressed in the constant's data-section allocation
+/// instead of copying the whole aggregate to a stack slot. The caller still has
+/// to check that the constant lowers to a by-reference `CValue` (an `Indirect`
+/// allocation); scalar constants stay in SSA values.
+pub(crate) fn analyze_const_locals<'tcx>(
+    mir: &'tcx Body<'tcx>,
+) -> IndexVec<Local, Option<ConstOperand<'tcx>>> {
+    let mut candidates: IndexVec<Local, Option<ConstOperand<'tcx>>> =
+        IndexVec::from_elem_n(None, mir.local_decls.len());
+    let mut rejected = IndexVec::from_elem_n(false, mir.local_decls.len());
+
+    for bb in mir.basic_blocks.iter() {
+        for stmt in bb.statements.iter() {
+            match &stmt.kind {
+                Assign(place_and_rval) => {
+                    let (place, rvalue) = &**place_and_rval;
+                    if place.projection.is_empty() {
+                        match rvalue {
+                            Rvalue::Use(Operand::Constant(constant), _)
+                                if candidates[place.local].is_none() && !rejected[place.local] =>
+                            {
+                                candidates[place.local] = Some((**constant).clone());
+                            }
+                            _ => reject_const_local(place.local, &mut candidates, &mut rejected),
+                        }
+                    } else {
+                        // Written through a projection: the bytes in the
+                        // constant allocation must not be reused for it.
+                        reject_const_local(place.local, &mut candidates, &mut rejected);
+                    }
+                    // Taking a reference (including one to a projection) lets
+                    // other code read or write the local.
+                    if let Rvalue::Ref(_, _, place)
+                    | Rvalue::RawPtr(_, place)
+                    | Rvalue::Reborrow(_, _, place) = rvalue
+                    {
+                        reject_const_local(place.local, &mut candidates, &mut rejected);
+                    }
+                }
+                SetDiscriminant { place, .. } => {
+                    reject_const_local(place.local, &mut candidates, &mut rejected)
+                }
+                _ => {}
+            }
+        }
+        match &bb.terminator().kind {
+            TerminatorKind::Call { destination, .. } => {
+                reject_const_local(destination.local, &mut candidates, &mut rejected);
+            }
+            TerminatorKind::Drop { place, .. } => {
+                reject_const_local(place.local, &mut candidates, &mut rejected);
+            }
+            TerminatorKind::Yield { resume_arg, .. } => {
+                reject_const_local(resume_arg.local, &mut candidates, &mut rejected);
+            }
+            TerminatorKind::InlineAsm { operands, .. } => {
+                for operand in &**operands {
+                    let place = match operand {
+                        InlineAsmOperand::Out { place, .. } => place.as_ref(),
+                        InlineAsmOperand::InOut { out_place, .. } => out_place.as_ref(),
+                        _ => None,
+                    };
+                    if let Some(place) = place {
+                        reject_const_local(place.local, &mut candidates, &mut rejected);
+                    }
+                }
+            }
+            _ => {}
+        }
+    }
+
+    candidates
+}
+
+fn reject_const_local<'tcx>(
+    local: Local,
+    candidates: &mut IndexVec<Local, Option<ConstOperand<'tcx>>>,
+    rejected: &mut IndexVec<Local, bool>,
+) {
+    rejected[local] = true;
+    candidates[local] = None;
+}
