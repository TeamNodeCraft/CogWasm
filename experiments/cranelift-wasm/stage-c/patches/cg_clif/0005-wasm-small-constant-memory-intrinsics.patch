--- /dev/null
+++ b/src/intrinsics/memory.rs
@@ -0,0 +1,203 @@
+//! `memcpy`, `memmove` and `memset` lowering.
+//!
+//! A constant, small length becomes straight-line loads and stores, as LLVM
+//! lowers it. A larger or variable length becomes the wasm bulk-memory
+//! instruction when the target has it, and a libc call otherwise.
+
+use clif_to_wasm::WasmIntrinsic;
+use cranelift_codegen::ir::{ExtFuncData, ExternalName};
+
+use crate::prelude::*;
+
+/// Copies of at most this many bytes are inlined. Eight 8-byte accesses are
+/// already more instructions than the engines' inlined `memory.copy`, and this
+/// covers the 8-byte swaps and short `[u8; N]` initialisations in core.
+const MAX_INLINE_BYTES: u64 = 64;
+
+/// Copy `byte_amount` bytes from `src` to `dst`.
+///
+/// `known_bytes` is the value of `byte_amount` when it is a compile-time
+/// constant. `align` is the alignment both pointers are guaranteed to have.
+/// With `non_overlapping` false the ranges may overlap; all source words are
+/// read before any destination word is written, which is memmove semantics.
+/// Volatile operations are never specialised.
+pub(crate) fn codegen_memory_copy(
+    fx: &mut FunctionCx<'_, '_, '_>,
+    dst: Value,
+    src: Value,
+    byte_amount: Value,
+    known_bytes: Option<u64>,
+    align: u64,
+    non_overlapping: bool,
+    volatile: bool,
+) {
+    if !volatile {
+        if let Some(bytes) = known_bytes {
+            if bytes == 0 {
+                return;
+            }
+            if bytes <= MAX_INLINE_BYTES {
+                emit_inline_copy(fx, dst, src, bytes, align);
+                return;
+            }
+        }
+        if bulk_memory_available(fx) {
+            call_wasm_memory_intrinsic(fx, WasmIntrinsic::MemoryCopy, &[dst, src, byte_amount]);
+            return;
+        }
+    }
+    if non_overlapping {
+        fx.bcx.call_memcpy(fx.target_config, dst, src, byte_amount);
+    } else {
+        fx.bcx.call_memmove(fx.target_config, dst, src, byte_amount);
+    }
+}
+
+/// Write `byte_amount` bytes of the low byte of `value` at `dst`.
+pub(crate) fn codegen_memory_set(
+    fx: &mut FunctionCx<'_, '_, '_>,
+    dst: Value,
+    value: Value,
+    byte_amount: Value,
+    known_bytes: Option<u64>,
+    align: u64,
+    volatile: bool,
+) {
+    if !volatile {
+        if let Some(bytes) = known_bytes {
+            if bytes == 0 {
+                return;
+            }
+            if bytes <= MAX_INLINE_BYTES {
+                emit_inline_fill(fx, dst, value, bytes, align);
+                return;
+            }
+        }
+        if bulk_memory_available(fx) {
+            // `memory.fill` takes an i32 byte value; the intrinsic's argument
+            // is an i8.
+            let value = if fx.bcx.func.dfg.value_type(value) == types::I32 {
+                value
+            } else {
+                fx.bcx.ins().uextend(types::I32, value)
+            };
+            call_wasm_memory_intrinsic(fx, WasmIntrinsic::MemoryFill, &[dst, value, byte_amount]);
+            return;
+        }
+    }
+    fx.bcx.call_memset(fx.target_config, dst, value, byte_amount);
+}
+
+/// The compile-time value of a MIR integer operand, if it has one.
+pub(crate) fn const_usize<'tcx>(
+    fx: &FunctionCx<'_, '_, 'tcx>,
+    operand: &mir::Operand<'tcx>,
+) -> Option<u64> {
+    let value = crate::constant::mir_operand_get_const_val(fx, operand)?;
+    u64::try_from(value.to_uint(value.size())).ok()
+}
+
+fn bulk_memory_available(fx: &FunctionCx<'_, '_, '_>) -> bool {
+    // The reserved helper calls only describe a 32-bit memory (like
+    // memory.grow/size); wasm64 keeps the libc call.
+    fx.pointer_type == types::I32 && crate::wasm::bulk_memory(fx.tcx.sess)
+}
+
+/// Emit a call to one of clif-to-wasm's reserved wasm instruction names.
+fn call_wasm_memory_intrinsic(
+    fx: &mut FunctionCx<'_, '_, '_>,
+    intrinsic: WasmIntrinsic,
+    args: &[Value],
+) {
+    let params = match intrinsic {
+        WasmIntrinsic::MemoryCopy | WasmIntrinsic::MemoryFill => {
+            vec![AbiParam::new(types::I32); 3]
+        }
+        _ => bug!("unexpected wasm memory intrinsic {intrinsic:?}"),
+    };
+    let sig = fx.bcx.func.import_signature(Signature {
+        call_conv: fx.target_config.default_call_conv,
+        params,
+        returns: vec![],
+    });
+    let func = fx.bcx.func.import_function(ExtFuncData {
+        name: ExternalName::testcase(intrinsic.symbol_name()),
+        signature: sig,
+        colocated: false,
+        patchable: false,
+    });
+    if fx.clif_comments.enabled() {
+        fx.add_comment(func, intrinsic.symbol_name().to_string());
+    }
+    fx.bcx.ins().call(func, args);
+}
+
+/// The widest access width (at most 8 bytes) that divides `bytes`.
+fn access_width(bytes: u64) -> u64 {
+    debug_assert!(bytes != 0);
+    1 << bytes.trailing_zeros().min(3)
+}
+
+fn access_type(width: u64) -> Type {
+    match width {
+        1 => types::I8,
+        2 => types::I16,
+        4 => types::I32,
+        8 => types::I64,
+        _ => unreachable!(),
+    }
+}
+
+/// Aligned only for the width the pointee's alignment actually guarantees.
+fn access_flags(width: u64, align: u64) -> MemFlagsData {
+    let mut flags = MemFlagsData::new();
+    if width <= align {
+        flags.set_aligned();
+    }
+    flags
+}
+
+fn emit_inline_copy(
+    fx: &mut FunctionCx<'_, '_, '_>,
+    dst: Value,
+    src: Value,
+    bytes: u64,
+    align: u64,
+) {
+    let width = access_width(bytes);
+    let ty = access_type(width);
+    let flags = access_flags(width, align);
+    // Load every source word before writing any destination word, so an
+    // overlapping range gets memmove semantics.
+    let values: Vec<Value> = (0..bytes / width)
+        .map(|i| fx.bcx.ins().load(ty, flags, src, (i * width) as i32))
+        .collect();
+    for (i, value) in values.into_iter().enumerate() {
+        fx.bcx.ins().store(flags, value, dst, (i as u64 * width) as i32);
+    }
+}
+
+fn emit_inline_fill(
+    fx: &mut FunctionCx<'_, '_, '_>,
+    dst: Value,
+    value: Value,
+    bytes: u64,
+    align: u64,
+) {
+    let width = access_width(bytes);
+    let ty = access_type(width);
+    let flags = access_flags(width, align);
+    // `memset` writes the low 8 bits of its `c_int` argument; replicate that
+    // byte to the access width.
+    let byte = fx.bcx.ins().band_imm_u(value, 0xff);
+    let fill = if width == 1 {
+        byte
+    } else {
+        let widened = fx.bcx.ins().uextend(ty, byte);
+        let factor = 0x0101_0101_0101_0101u64 >> (64 - width * 8);
+        fx.bcx.ins().imul_imm_u(widened, factor as i64)
+    };
+    for i in 0..bytes / width {
+        fx.bcx.ins().store(flags, fill, dst, (i * width) as i32);
+    }
+}
