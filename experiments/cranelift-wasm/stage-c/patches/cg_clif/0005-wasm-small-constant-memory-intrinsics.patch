+/// Whether the target has the bulk-memory proposal, and so `memory.copy` and
+/// `memory.fill` are available.
+///
+/// LLVM's wasm "generic" CPU, the default for `wasm32-unknown-unknown`,
+/// enables it, and the `target_features` section of every object we write
+/// declares it. Only an explicit `-bulk-memory` turns it off, so follow LLVM
+/// rather than requiring `+bulk-memory` in the target spec (which is empty).
+pub(crate) fn bulk_memory(sess: &Session) -> bool {
+    if !is_wasm(sess) {
+        return false;
+    }
+    let mut enabled = true;
+    for list in [&*sess.target.options.features, &sess.opts.cg.target_feature] {
+        for feature in list.split(',') {
+            match feature {
+                "+bulk-memory" => enabled = true,
+                "-bulk-memory" => enabled = false,
+                _ => {}
+            }
+        }
+    }
+    enabled
+}
+
 /// Whether the program has threads (shared memory and TLS).
 pub(crate) fn threads(sess: &Session) -> bool {
     target_features(sess).iter().any(|f| f == "atomics")
