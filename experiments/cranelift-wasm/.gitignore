# All downloaded sources, toolchains and build outputs live here.
/toolchain/

# Per-program Cargo outputs (we build with a central CARGO_TARGET_DIR).
/stage-c/programs/**/target/

# Build artifacts; keep results/*.md and results/*.json.
*.wasm
*.o
*.cwasm

# Local/CI stage-C build log (the workflow publishes its own full log).
/stage-c/results/build-rustc-wasm.log

# Release bundle outputs (local dry runs and the packaging script).
/release/out/
/release/dist/
*.cwasm.json

# Python bytecode from the release notices generator.
__pycache__/
*.pyc
